// P16, transcribed from the production kernel at commit
// 399563ec6dbb4e8f2db025a9cf5125fc61ac8a3a. Same instruction order,
// round-loop alignment, unwind directives and constants. Not yet proved.
// G4 interleaves four independent G chains; expanding it preserves their schedule.

data p16_iv = 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a

// The contract its callers assume of it (../lang/Spec_p16.lean); tried on that contract's examples in the machine
// model by ../lang/try_kernel.sh.
kernel p16 meets P16.contract(k: Blake3.CV, base: BitVec 64, n: BitVec 64, flags: BitVec 64, l: List Blake3.CV)

kernel p16 replaces "blake3_servil_avx512_p16" {
  .p2align 6
  def g4(a0, a1, a2, a3, b0, b1, b2, b3, c0, c1, c2, c3, d0, d1, d2, d3, x0, x1, x2, x3, y0, y1, y2, y3) {
    vpaddd $a0, $a0, $x0
    vpaddd $a1, $a1, $x1
    vpaddd $a2, $a2, $x2
    vpaddd $a3, $a3, $x3
    vpaddd $a0, $a0, $b0
    vpaddd $a1, $a1, $b1
    vpaddd $a2, $a2, $b2
    vpaddd $a3, $a3, $b3
    vpxord $d0, $d0, $a0
    vpxord $d1, $d1, $a1
    vpxord $d2, $d2, $a2
    vpxord $d3, $d3, $a3
    vprord $d0, $d0, 16
    vprord $d1, $d1, 16
    vprord $d2, $d2, 16
    vprord $d3, $d3, 16
    vpaddd $c0, $c0, $d0
    vpaddd $c1, $c1, $d1
    vpaddd $c2, $c2, $d2
    vpaddd $c3, $c3, $d3
    vpxord $b0, $b0, $c0
    vpxord $b1, $b1, $c1
    vpxord $b2, $b2, $c2
    vpxord $b3, $b3, $c3
    vprord $b0, $b0, 12
    vprord $b1, $b1, 12
    vprord $b2, $b2, 12
    vprord $b3, $b3, 12
    vpaddd $a0, $a0, $y0
    vpaddd $a1, $a1, $y1
    vpaddd $a2, $a2, $y2
    vpaddd $a3, $a3, $y3
    vpaddd $a0, $a0, $b0
    vpaddd $a1, $a1, $b1
    vpaddd $a2, $a2, $b2
    vpaddd $a3, $a3, $b3
    vpxord $d0, $d0, $a0
    vpxord $d1, $d1, $a1
    vpxord $d2, $d2, $a2
    vpxord $d3, $d3, $a3
    vprord $d0, $d0, 8
    vprord $d1, $d1, 8
    vprord $d2, $d2, 8
    vprord $d3, $d3, 8
    vpaddd $c0, $c0, $d0
    vpaddd $c1, $c1, $d1
    vpaddd $c2, $c2, $d2
    vpaddd $c3, $c3, $d3
    vpxord $b0, $b0, $c0
    vpxord $b1, $b1, $c1
    vpxord $b2, $b2, $c2
    vpxord $b3, $b3, $c3
    vprord $b0, $b0, 7
    vprord $b1, $b1, 7
    vprord $b2, $b2, 7
    vprord $b3, $b3, 7
  }

  .cfi_startproc
  endbr64
  push rbp
  .cfi_def_cfa_offset 16
  .cfi_offset rbp, -16
  mov rbp, rsp
  .cfi_def_cfa_register rbp
  push rbx
  .cfi_offset rbx, -24
  push r12
  .cfi_offset r12, -32
  push r13
  .cfi_offset r13, -40
  push r14
  .cfi_offset r14, -48
  push r15
  .cfi_offset r15, -56
  and rsp, -64
  sub rsp, 256
  mov BYTE PTR [rsp], 0
  mov r12, rdi
  mov r13, rsi
  mov r14, rdx
  mov r15, r9
  mov rbx, r8
  mov r9, rcx
  vpbroadcastd zmm0, DWORD PTR [r14 + 0]
  vpbroadcastd zmm1, DWORD PTR [r14 + 4]
  vpbroadcastd zmm2, DWORD PTR [r14 + 8]
  vpbroadcastd zmm3, DWORD PTR [r14 + 12]
  vpbroadcastd zmm4, DWORD PTR [r14 + 16]
  vpbroadcastd zmm5, DWORD PTR [r14 + 20]
  vpbroadcastd zmm6, DWORD PTR [r14 + 24]
  vpbroadcastd zmm7, DWORD PTR [r14 + 28]
  xor r14d, r14d
  movzx r8d, bl
  mov r10d, ebx
  shr r10d, 8
  and r10d, 255
  or r10d, r8d
  mov edi, ebx
  shr edi, 16
  and edi, 255
  mov esi, ebx
  shr esi, 24
  @block16:
  mov rax, QWORD PTR [r12 + 0]
  vmovdqu32 zmm16, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 8]
  vmovdqu32 zmm17, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 16]
  vmovdqu32 zmm18, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 24]
  vmovdqu32 zmm19, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 32]
  vmovdqu32 zmm20, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 40]
  vmovdqu32 zmm21, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 48]
  vmovdqu32 zmm22, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 56]
  vmovdqu32 zmm23, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 64]
  vmovdqu32 zmm24, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 72]
  vmovdqu32 zmm25, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 80]
  vmovdqu32 zmm26, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 88]
  vmovdqu32 zmm27, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 96]
  vmovdqu32 zmm28, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 104]
  vmovdqu32 zmm29, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 112]
  vmovdqu32 zmm30, ZMMWORD PTR [rax + r14]
  mov rax, QWORD PTR [r12 + 120]
  vmovdqu32 zmm31, ZMMWORD PTR [rax + r14]
  vpunpckldq zmm8, zmm16, zmm17
  vpunpckhdq zmm16, zmm16, zmm17
  vpunpckldq zmm17, zmm18, zmm19
  vpunpckhdq zmm18, zmm18, zmm19
  vpunpckldq zmm19, zmm20, zmm21
  vpunpckhdq zmm20, zmm20, zmm21
  vpunpckldq zmm21, zmm22, zmm23
  vpunpckhdq zmm22, zmm22, zmm23
  vpunpckldq zmm23, zmm24, zmm25
  vpunpckhdq zmm24, zmm24, zmm25
  vpunpckldq zmm25, zmm26, zmm27
  vpunpckhdq zmm26, zmm26, zmm27
  vpunpckldq zmm27, zmm28, zmm29
  vpunpckhdq zmm28, zmm28, zmm29
  vpunpckldq zmm29, zmm30, zmm31
  vpunpckhdq zmm30, zmm30, zmm31
  vpunpcklqdq zmm31, zmm8, zmm17
  vpunpckhqdq zmm8, zmm8, zmm17
  vpunpcklqdq zmm17, zmm16, zmm18
  vpunpckhqdq zmm16, zmm16, zmm18
  vpunpcklqdq zmm18, zmm19, zmm21
  vpunpckhqdq zmm19, zmm19, zmm21
  vpunpcklqdq zmm21, zmm20, zmm22
  vpunpckhqdq zmm20, zmm20, zmm22
  vpunpcklqdq zmm22, zmm23, zmm25
  vpunpckhqdq zmm23, zmm23, zmm25
  vpunpcklqdq zmm25, zmm24, zmm26
  vpunpckhqdq zmm24, zmm24, zmm26
  vpunpcklqdq zmm26, zmm27, zmm29
  vpunpckhqdq zmm27, zmm27, zmm29
  vpunpcklqdq zmm29, zmm28, zmm30
  vpunpckhqdq zmm28, zmm28, zmm30
  vshufi32x4 zmm30, zmm31, zmm18, 0x88
  vshufi32x4 zmm31, zmm31, zmm18, 0xdd
  vshufi32x4 zmm18, zmm17, zmm21, 0x88
  vshufi32x4 zmm17, zmm17, zmm21, 0xdd
  vshufi32x4 zmm21, zmm8, zmm19, 0x88
  vshufi32x4 zmm8, zmm8, zmm19, 0xdd
  vshufi32x4 zmm19, zmm16, zmm20, 0x88
  vshufi32x4 zmm16, zmm16, zmm20, 0xdd
  vshufi32x4 zmm20, zmm22, zmm26, 0x88
  vshufi32x4 zmm22, zmm22, zmm26, 0xdd
  vshufi32x4 zmm26, zmm25, zmm29, 0x88
  vshufi32x4 zmm25, zmm25, zmm29, 0xdd
  vshufi32x4 zmm29, zmm23, zmm27, 0x88
  vshufi32x4 zmm23, zmm23, zmm27, 0xdd
  vshufi32x4 zmm27, zmm24, zmm28, 0x88
  vshufi32x4 zmm24, zmm24, zmm28, 0xdd
  vshufi32x4 zmm28, zmm30, zmm20, 0x88
  vshufi32x4 zmm30, zmm30, zmm20, 0xdd
  vshufi32x4 zmm20, zmm18, zmm26, 0x88
  vshufi32x4 zmm18, zmm18, zmm26, 0xdd
  vshufi32x4 zmm26, zmm21, zmm29, 0x88
  vshufi32x4 zmm21, zmm21, zmm29, 0xdd
  vshufi32x4 zmm29, zmm19, zmm27, 0x88
  vshufi32x4 zmm19, zmm19, zmm27, 0xdd
  vshufi32x4 zmm27, zmm31, zmm22, 0x88
  vshufi32x4 zmm31, zmm31, zmm22, 0xdd
  vshufi32x4 zmm22, zmm17, zmm25, 0x88
  vshufi32x4 zmm17, zmm17, zmm25, 0xdd
  vshufi32x4 zmm25, zmm8, zmm23, 0x88
  vshufi32x4 zmm8, zmm8, zmm23, 0xdd
  vshufi32x4 zmm23, zmm16, zmm24, 0x88
  vshufi32x4 zmm16, zmm16, zmm24, 0xdd
  mov eax, r10d
  mov edx, 64
  cmp r13, 1
  jne @flags16
  or eax, edi
  mov edx, esi
  @flags16:
  vpbroadcastd zmm9, DWORD PTR [rip + #p16_iv + 0]
  vpbroadcastd zmm10, DWORD PTR [rip + #p16_iv + 4]
  vpbroadcastd zmm11, DWORD PTR [rip + #p16_iv + 8]
  vpbroadcastd zmm12, DWORD PTR [rip + #p16_iv + 12]
  vpbroadcastd zmm13, r9d
  mov rcx, r9
  shr rcx, 32
  vpbroadcastd zmm14, ecx
  vpbroadcastd zmm15, edx
  vpbroadcastd zmm24, eax
  mov r11d, 7
  .p2align 5
  @round16:
  g4(zmm0, zmm1, zmm2, zmm3, zmm4, zmm5, zmm6, zmm7, zmm9, zmm10, zmm11, zmm12, zmm13, zmm14, zmm15, zmm24, zmm28, zmm20, zmm27, zmm22, zmm26, zmm29, zmm25, zmm23)
  g4(zmm0, zmm1, zmm2, zmm3, zmm5, zmm6, zmm7, zmm4, zmm11, zmm12, zmm9, zmm10, zmm24, zmm13, zmm14, zmm15, zmm30, zmm18, zmm31, zmm17, zmm21, zmm19, zmm8, zmm16)
  dec r11d
  jz @round_done16
  g4(zmm0, zmm1, zmm2, zmm3, zmm4, zmm5, zmm6, zmm7, zmm9, zmm10, zmm11, zmm12, zmm13, zmm14, zmm15, zmm24, zmm20, zmm29, zmm23, zmm27, zmm22, zmm18, zmm28, zmm8)
  g4(zmm0, zmm1, zmm2, zmm3, zmm5, zmm6, zmm7, zmm4, zmm11, zmm12, zmm9, zmm10, zmm24, zmm13, zmm14, zmm15, zmm26, zmm31, zmm21, zmm16, zmm19, zmm25, zmm17, zmm30)
  dec r11d
  vmovdqa32 ZMMWORD PTR [rsp + 0], zmm28
  vmovdqa32 zmm28, zmm29
  vmovdqa32 zmm29, zmm31
  vmovdqa32 zmm31, zmm19
  vmovdqa32 zmm19, ZMMWORD PTR [rsp + 0]
  vmovdqa32 ZMMWORD PTR [rsp + 64], zmm26
  vmovdqa32 zmm26, zmm27
  vmovdqa32 zmm27, zmm8
  vmovdqa32 zmm8, zmm16
  vmovdqa32 zmm16, ZMMWORD PTR [rsp + 64]
  vmovdqa32 ZMMWORD PTR [rsp + 128], zmm20
  vmovdqa32 zmm20, zmm18
  vmovdqa32 zmm18, zmm21
  vmovdqa32 zmm21, zmm25
  vmovdqa32 zmm25, ZMMWORD PTR [rsp + 128]
  vmovdqa32 ZMMWORD PTR [rsp + 192], zmm22
  vmovdqa32 zmm22, zmm23
  vmovdqa32 zmm23, zmm17
  vmovdqa32 zmm17, zmm30
  vmovdqa32 zmm30, ZMMWORD PTR [rsp + 192]
  jmp @round16
  @round_done16:
  vpxord zmm0, zmm0, zmm9
  vpxord zmm1, zmm1, zmm10
  vpxord zmm2, zmm2, zmm11
  vpxord zmm3, zmm3, zmm12
  vpxord zmm4, zmm4, zmm13
  vpxord zmm5, zmm5, zmm14
  vpxord zmm6, zmm6, zmm15
  vpxord zmm7, zmm7, zmm24
  mov r10d, r8d
  add r14, 64
  dec r13
  jne @block16
  vpunpckldq zmm16, zmm0, zmm1
  vpunpckhdq zmm0, zmm0, zmm1
  vpunpckldq zmm1, zmm2, zmm3
  vpunpckhdq zmm2, zmm2, zmm3
  vpunpckldq zmm3, zmm4, zmm5
  vpunpckhdq zmm4, zmm4, zmm5
  vpunpckldq zmm5, zmm6, zmm7
  vpunpckhdq zmm6, zmm6, zmm7
  vpunpcklqdq zmm7, zmm16, zmm1
  vpunpckhqdq zmm16, zmm16, zmm1
  vpunpcklqdq zmm1, zmm0, zmm2
  vpunpckhqdq zmm0, zmm0, zmm2
  vpunpcklqdq zmm2, zmm3, zmm5
  vpunpckhqdq zmm3, zmm3, zmm5
  vpunpcklqdq zmm5, zmm4, zmm6
  vpunpckhqdq zmm4, zmm4, zmm6
  vshufi32x4 zmm6, zmm7, zmm2, 0x88
  vshufi32x4 zmm7, zmm7, zmm2, 0xdd
  vshufi32x4 zmm2, zmm1, zmm5, 0x88
  vshufi32x4 zmm1, zmm1, zmm5, 0xdd
  vshufi32x4 zmm5, zmm16, zmm3, 0x88
  vshufi32x4 zmm16, zmm16, zmm3, 0xdd
  vshufi32x4 zmm3, zmm0, zmm4, 0x88
  vshufi32x4 zmm0, zmm0, zmm4, 0xdd
  vshufi32x4 zmm4, zmm6, zmm5, 136
  vmovdqu32 ZMMWORD PTR [r15 + 0], zmm4
  vshufi32x4 zmm4, zmm2, zmm3, 136
  vmovdqu32 ZMMWORD PTR [r15 + 64], zmm4
  vshufi32x4 zmm4, zmm7, zmm16, 136
  vmovdqu32 ZMMWORD PTR [r15 + 128], zmm4
  vshufi32x4 zmm4, zmm1, zmm0, 136
  vmovdqu32 ZMMWORD PTR [r15 + 192], zmm4
  vshufi32x4 zmm4, zmm6, zmm5, 221
  vmovdqu32 ZMMWORD PTR [r15 + 256], zmm4
  vshufi32x4 zmm4, zmm2, zmm3, 221
  vmovdqu32 ZMMWORD PTR [r15 + 320], zmm4
  vshufi32x4 zmm4, zmm7, zmm16, 221
  vmovdqu32 ZMMWORD PTR [r15 + 384], zmm4
  vshufi32x4 zmm4, zmm1, zmm0, 221
  vmovdqu32 ZMMWORD PTR [r15 + 448], zmm4
  vzeroupper
  lea rsp, [rbp - 40]
  pop r15
  .cfi_restore r15
  pop r14
  .cfi_restore r14
  pop r13
  .cfi_restore r13
  pop r12
  .cfi_restore r12
  pop rbx
  .cfi_restore rbx
  pop rbp
  .cfi_def_cfa rsp, 8
  .cfi_restore rbp
  ret
  .cfi_endproc
}
