// The one-block kernel (AVX-512VL on XMM registers), written in Ode's instruction layer. November 17, 2026.
//
// It is the crate's `blake3_servil_compress_in_place_avx512` (c/blake3_avx512_x86-64_unix.S), instruction for
// instruction: `test_one_source.py` assembles both and compares the bytes. First of the kernels to go the
// whole way from Ode source: source here, the same bytes as the crate's, verified by the verifier of
// functions (kcheck/kfn.py) with no verifier of kernels loaded.
//
// (cv, block, length, counter, flags) in rdi, rsi, dl, rcx, r8b: the 32 bytes at cv become the first eight
// words of BLAKE3's compression of them with the 64 bytes at block.

data one_iv = 0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A

kernel compress1 replaces "blake3_servil_compress_in_place_avx512" {
  .p2align 6
  // half of a round: the four columns (or, the rows turned, the four diagonals) mixed with eight words of the block
  def g(x, y) {
    vpaddd xmm0, xmm0, $x
    vpaddd xmm0, xmm0, xmm1
    vpxord xmm3, xmm3, xmm0
    vprord xmm3, xmm3, 16
    vpaddd xmm2, xmm2, xmm3
    vpxord xmm1, xmm1, xmm2
    vprord xmm1, xmm1, 12
    vpaddd xmm0, xmm0, $y
    vpaddd xmm0, xmm0, xmm1
    vpxord xmm3, xmm3, xmm0
    vprord xmm3, xmm3, 8
    vpaddd xmm2, xmm2, xmm3
    vpxord xmm1, xmm1, xmm2
    vprord xmm1, xmm1, 7
  }
  vmovdqu xmm0, xmmword ptr [rdi]
  vmovdqu xmm1, xmmword ptr [rdi+0x10]
  movzx eax, r8b
  movzx edx, dl
  shl rax, 32
  add rdx, rax
  vmovq xmm3, rcx
  vmovq xmm4, rdx
  vpunpcklqdq xmm3, xmm3, xmm4
  vmovaps xmm2, xmmword ptr [rip + #one_iv]
  vmovups xmm8, xmmword ptr [rsi]
  vmovups xmm9, xmmword ptr [rsi+0x10]
  vshufps xmm4, xmm8, xmm9, 136
  vshufps xmm5, xmm8, xmm9, 221
  vmovups xmm8, xmmword ptr [rsi+0x20]
  vmovups xmm9, xmmword ptr [rsi+0x30]
  vshufps xmm6, xmm8, xmm9, 136
  vshufps xmm7, xmm8, xmm9, 221
  vpshufd xmm6, xmm6, 0x93
  vpshufd xmm7, xmm7, 0x93
  mov al, 7
  @round:
  g(xmm4, xmm5)
  vpshufd xmm0, xmm0, 0x93
  vpshufd xmm3, xmm3, 0x4E
  vpshufd xmm2, xmm2, 0x39
  g(xmm6, xmm7)
  vpshufd xmm0, xmm0, 0x39
  vpshufd xmm3, xmm3, 0x4E
  vpshufd xmm2, xmm2, 0x93
  dec al
  jz @done
  // the block's words permuted for the next round
  vshufps xmm8, xmm4, xmm5, 214
  vpshufd xmm9, xmm4, 0x0F
  vpshufd xmm4, xmm8, 0x39
  vshufps xmm8, xmm6, xmm7, 250
  vpblendd xmm9, xmm9, xmm8, 0xAA
  vpunpcklqdq xmm8, xmm7, xmm5
  vpblendd xmm8, xmm8, xmm6, 0x88
  vpshufd xmm8, xmm8, 0x78
  vpunpckhdq xmm5, xmm5, xmm7
  vpunpckldq xmm6, xmm6, xmm5
  vpshufd xmm7, xmm6, 0x1E
  vmovdqa xmm5, xmm9
  vmovdqa xmm6, xmm8
  jmp @round
  @done:
  vpxor xmm0, xmm0, xmm2
  vpxor xmm1, xmm1, xmm3
  vmovdqu xmmword ptr [rdi], xmm0
  vmovdqu xmmword ptr [rdi+0x10], xmm1
  ret
}
