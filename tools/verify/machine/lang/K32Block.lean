    ∃ st', steps Code_k32.prog 112 st = some st' ∧ st'.pc = 0x1042A ∧
      (st'.zmm 28 = zpack (fun i => (m i)[0]) ∧ st'.zmm 26 = zpack (fun i => (m i)[1]) ∧ st'.zmm 20 = zpack (fun i => (m i)[2]) ∧ st'.zmm 29 = zpack (fun i => (m i)[3]) ∧ st'.zmm 27 = zpack (fun i => (m i)[4]) ∧ st'.zmm 25 = zpack (fun i => (m i)[5]) ∧ st'.zmm 22 = zpack (fun i => (m i)[6]) ∧ st'.zmm 23 = zpack (fun i => (m i)[7]) ∧ st'.zmm 30 = zpack (fun i => (m i)[8]) ∧ st'.zmm 21 = zpack (fun i => (m i)[9]) ∧ st'.zmm 18 = zpack (fun i => (m i)[10]) ∧ st'.zmm 19 = zpack (fun i => (m i)[11]) ∧ st'.zmm 31 = zpack (fun i => (m i)[12]) ∧ st'.zmm 15 = zpack (fun i => (m i)[13]) ∧ st'.zmm 17 = zpack (fun i => (m i)[14]) ∧ st'.zmm 16 = zpack (fun i => (m i)[15])) ∧
      (∀ r, r ≤ 14 → st'.zmm r = st.zmm r) ∧
      st'.rcx = st.rcx ∧ st'.rdx = st.rdx ∧ st'.rbx = st.rbx ∧ st'.rsp = st.rsp ∧ st'.rbp = st.rbp ∧ st'.rsi = st.rsi ∧ st'.rdi = st.rdi ∧ st'.r8 = st.r8 ∧ st'.r9 = st.r9 ∧ st'.r12 = st.r12 ∧ st'.r13 = st.r13 ∧ st'.r14 = st.r14 ∧ st'.r15 = st.r15 ∧ st'.w.r10 = st.w.r10 ∧ st'.w.r11 = st.w.r11 ∧ st'.mem = st.mem := by
