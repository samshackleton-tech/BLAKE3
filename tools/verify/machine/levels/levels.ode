// The tree of chaining values another way (an experiment beside hasher.ode's stack; Sam's design, November 12).
//
// The stack (push, merge) keeps one value a pending subtree, puts a parent where its left child was, and
// is merged when a value arrives, so its caller must hold back whatever might be the root.
// Here:
//   - a parent is written into memory of its own, never over its children: each level of the tree
//     has room for two values side by side, which are a parent's 64-byte block as they lie;
//   - the two newest values wait at the bottom level until a third arrives: only then is it known that
//     they are not the root's children (the root is hashed differently). Above the bottom a pair
//     becomes its parent as soon as it is complete, for by then a later value exists. So every chunk's
//     value is added, the last one too, and `lroot` makes the root, by one fold.
//
// The levels: the count of values added (a word) at offset 0; level L's two places at offset
// 64 + 64 L, 32 bytes each; 54 levels; 3520 bytes. What is held follows from the count n: the bottom
// level holds the newest value if n is odd and the newest two if it is even; with e = (n - 1) / 2
// pairs given upward, level L >= 1 holds one value, in its first place, if bit L - 1 of e is set.
//
// (A first form waited at every level, not only the bottom: as fast, but its root took three cases a
// level, 272 instructions; it is in this folder's history, and README.md has its numbers.)

const CHUNK_START = 1
const CHUNK_END   = 2
const PARENT      = 4
const ROOT        = 8
const AVX512      = 5
const AVX2        = 4

extern compress_avx512/5  = "blake3_servil_compress_in_place_avx512"
extern compress_sse41/5   = "blake3_servil_compress_in_place_sse41"
callee compress_avx512 meets Kernels.call_avx_runs (8)
callee compress_sse41 meets Kernels.call_sse_runs (10)
extern hash_many_avx512/10 = "blake3_servil_hash_many_avx512"
extern hash_many_avx2/10   = "blake3_servil_hash_many_avx2"
extern hash_many_sse41/10  = "blake3_servil_hash_many_sse41"

def compress(cv, block, block_len, counter, flags) {
  if plat == AVX512 { compress_avx512(cv, block, block_len, counter, flags) }
  else              { compress_sse41(cv, block, block_len, counter, flags) }
}

def level_at(L) = lv + 64 + (L << 6)

// The value at t is added. While a level holds two values (x, the count of values that reached it, is
// even), they give their parent to the level above: to its first place, or to its second if it holds one
// already (then the next turn finds that level full). Every parent is written where nothing needed
// lies. Then the new value takes the bottom's next place. (This is `ladd`'s body: `ladd` below has it
// written out with what the prover needs; `hash2` uses it from here.)
def levels_add() {
  ln = u64[lv]
  x = ln | ((ln - 1) >> 63)          // the count; or 1 where nothing was added yet (no pair to give)
  src = lv + 64
  while x & 1 == 0 {
    x = x >> 1
    dst = src + 64 + (((x + 1) & 1) << 5)
    copy 32 dst <- key
    compress(dst, src, 64, 0, pf)
    src = src + 64
  }
  copy 32 lv + 64 + ((ln & 1) << 5) <- t
  u64[lv] = ln + 1
}

// The root of the values added (two or more), written at out; the levels are left as they are.
// The newest chunk's value waits at the bottom; each level that holds a value (a bit of the count less
// one) is folded onto it, the lowest first. The last parent made is the root.
def levels_root() {
  ln = u64[lv]
  e = ln - 1                              // the levels have received all the chunks but the newest
  base = lv + 64
  copy 32 acc <- base + ((e & 1) << 5)    // the newest chunk's value: in the bottom's next place
  while e > 0 {
    if e & 1 == 1 {
      f = pf
      if e == 1 { f = pf | ROOT }         // the highest level that holds a value: this parent is the root
      copy 32 blk <- base
      copy 32 blk + 32 <- acc
      copy 32 acc <- key
      compress(acc, blk, 64, 0, f)
    }
    e = e >> 1
    base = base + 64
  }
  copy 32 out <- acc
}

// A chunk's value arrives. What ladd is claimed to do is its contract, written in Lean for a reader:
// Ladd.contract (../lang/Spec_ladd.lean). Here is the code, and for its loop what the prover needs and no
// reader does. The lemmas named are in ../lang/Lemmas_ladd.lean.
fn ladd(lv, key, flags, plat, cv)
  reg x, src, lv, key, plat, dst
  meets Ladd.contract(k: Blake3.CV, chunks: Array Blake3.Node, new: Blake3.Node)
  uses Lemmas_ladd
  enter know Levels.At.start
  enter know Ladd.New.intro
  leave open Ladd.New.vectors as t0, t1
  leave by Ladd.exit
{
  var pf = flags | PARENT
  var ln = u64[lv]
  var x = ln | ((ln - 1) >> 63)
  var src = lv + 64
  while x & 1 == 0
    invariant Levels.Mid(lv, k, flags, chunks, src, x)      by Levels.Mid.carry
    invariant Cv.At(key, k)
    invariant Ladd.New(cv, new)
    invariant pf == flags | PARENT
    invariant ln == Levels.count(chunks)
    decreases x
    open Levels.Mid.full as l0, l1, r0, r1
    open Cv.At.vectors as k0, k1
  {
    x = x >> 1
    var dst = src + 64 + (((x + 1) & 1) << 5)
    copy 32 dst <- key
    compress(dst, src, 64, 0, pf)
    src = src + 64
  }
  copy 32 lv + 64 + ((ln & 1) << 5) <- cv
  u64[lv] = ln + 1
  return ln + 1
}

// The root. What lroot is claimed to do is Lroot.contract (../lang/Spec_lroot.lean); the lemmas named are in
// ../lang/Lemmas_lroot.lean. `Levels.Fold` says what holds at the loop's head: the levels from `base` up are
// still to be folded, and `acc` holds the subtree over all the chunks they do not cover.
fn lroot(out, lv, key, flags, plat, root)
  reg e, base, f, lv, key, plat
  meets Lroot.contract(k: Blake3.CV, chunks: Array Blake3.Node)
  uses Lemmas_lroot
  enter know Levels.At.cell
  enter open Levels.At.newest as n0, n1
  leave open Levels.Fold.done as r0, r1
  leave by Lroot.exit
{
  buf blk[64]
  buf acc[32]
  var pf = flags | PARENT
  var e = u64[lv] - 1                     // the levels have received all the chunks but the newest
  var base = lv + 64
  copy 32 acc <- base + ((e & 1) << 5)    // the newest chunk's value: in the bottom's next place
  while e > 0
    invariant Levels.Fold(lv, k, flags, root, chunks, base, e, acc)   by Levels.Fold.root | Levels.Fold.parent | Levels.Fold.skip   from Levels.Fold.start
    invariant Cv.At(key, k)
    invariant Region(out, 32)             // the bytes the root goes to are the program's, through the loop
    invariant pf == flags | PARENT
    decreases e
    open Cv.At.vectors as k0, k1
    open Levels.Fold.acc as a0, a1
    open Levels.Fold.level as l0, l1 when e & 1 == 1
  {
    if e & 1 == 1 {
      var f = pf
      if e == 1 { f = pf | root }         // the highest level that holds a value: this parent is the top (the root, if the caller says so)
      copy 32 blk <- base
      copy 32 blk + 32 <- acc
      copy 32 acc <- key
      compress(acc, blk, 64, 0, f)
    }
    e = e >> 1
    base = base + 64
  }
  copy 32 out <- acc
}

// A chunk's last block as a compression reads it: the n bytes at src (at most 64), then zeros to 64. What
// pad is claimed to do is Pad.contract (../lang/Spec_pad.lean). One loop writes all 64 bytes, the highest
// first: a byte of the message where there is one, a zero past its end.
fn pad(block, src, n)
  meets Pad.contract(bytes: List (BitVec 8))
  uses Lemmas_pad
  leave by Pad.exit
{
  var i = 64
  while i > 0
    invariant Pad.Mid(block, src, bytes, n, i)   by Pad.Mid.copy | Pad.Mid.zero   from Pad.Mid.start
    decreases i
    open Pad.Mid.next as b when i - 1 < n
  {
    i = i - 1
    if i < n { u8[block + i] = u8[src + i] }
    else     { u8[block + i] = 0 }
  }
}

callee pad at 0xE0000 meets Pad.contract by Proof_pad.pad_meets budget 64

// A chunk's node, as the specification has it (Blake3.chunkNode): h, the chaining value after every block
// but the last; the last block, padded; the chunk's number; the last block's length; its flags. What
// chunk_node is claimed to do is ChunkNode.contract (../lang/Spec_chunknode.lean). The key is in the node's h
// at the call, where the specification starts it. The lemmas named are in ../lang/Lemmas_chunk.lean:
// `Chunk.Mid` says what holds at the loop's head (h is the value after the blocks hashed so far, and rem
// bytes are left from p).
fn chunk_node(nd, input, len, counter, flags, plat)
  reg p, rem, first, nd, counter, plat
  meets ChunkNode.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_chunk
  leave open Chunk.Mid.last as _u
  leave by ChunkNode.exit
{
  var first = CHUNK_START
  var p = input
  var rem = len
  while rem > 64
    invariant Chunk.Mid(nd, input, len, counter, flags, k, bytes, p, rem, first)   by Chunk.Mid.step   from Chunk.Mid.start
    decreases rem
    open Chunk.Mid.block as h0, h1, b0, b1, b2, b3
  {
    var f = flags | first
    compress(nd, p, 64, counter, f)
    first = 0
    p = p + 64
    rem = rem - 64
  }
  var blk = nd + 32
  pad(blk, p, rem)
    with (Chunk.rest bytes)
    keep Cv.At(nd, Chunk.h(k, flags, counter, bytes))
    keep Region(nd, 120)
  u64[nd + 96] = counter
  u64[nd + 104] = rem
  u64[nd + 112] = flags | first | CHUNK_END
}

// A node's compression: its chaining value, or with root = ROOT the first 32 bytes of its output. What
// node_out is claimed to do is NodeOut.contract (../lang/Spec_nodeout.lean): the node in memory is the
// specification's own (h, the block m, the counter, the block length, the flags), 120 bytes.
fn node_out(out, nd, root, plat)
  meets NodeOut.contract(node: Blake3.Node)
  uses Lemmas_node
  enter know Node.At.cells
  enter open Node.At.vectors as h0, h1, b0, b1, b2, b3
  leave by NodeOut.exit
{
  var blk = nd + 32
  var len = u64[nd + 104]
  var t = u64[nd + 96]
  var f = u64[nd + 112] | root
  copy 32 out <- nd
  compress(out, blk, len, t, f)
}

callee chunk_node at 0xF0000 meets ChunkNode.contract by Proof_chunk_node.chunk_node_meets budget 256
callee node_out   at 0xD0000 meets NodeOut.contract   by Proof_node_out.node_out_meets     budget 256
callee ladd       at 0xB0000 meets Ladd.contract      by Proof_ladd.ladd_meets             budget 256
callee lroot      at 0xC0000 meets Lroot.contract     by Proof_lroot.lroot_meets           budget 256

// The whole hash, by the functions above, each called by its contract: every chunk's node is made
// (chunk_node), its value added to the levels (node_out, ladd), and the root made (lroot); one chunk alone
// is the root itself (node_out with ROOT). What hashl is claimed to do is Hashl.contract
// (../lang/Spec_hashl.lean): the 32 bytes at out become BLAKE3's of the message. One block at a time
// through the one-block kernels: slow, and every instruction of it under a theorem.
// `Hash.In` says where the loop is in the message, `Hash.Lv` that the levels are over the chunks done so far
// (../lang/Lemmas_hashl.lean).
fn hashl(out, input, len, key, flags, plat)
  reg p, rem, counter, key, flags, plat
  meets Hashl.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_hashl
  leave open Hash.last as _u
  leave open Cv.At.vectors as k0, k1
  leave by Hashl.exit
{
  buf lv[3520]
  buf nd[120]
  buf cv[32]
  u64[lv] = 0
  var p = input
  var rem = len
  var counter = 0
  while rem > 1024
    invariant Hash.In(input, len, bytes, p, rem, counter)                  by Hash.In.step   from Hash.In.start
    invariant Hash.Lv(lv, k, flags, Hash.nodes(k, flags, bytes, counter))   by Hash.Lv.step   from Hash.Lv.start
    invariant Cv.At(key, k)
    invariant Region(out, 32)             // the bytes the hash goes to are the program's, through the loop
    decreases rem
    open Hash.turn as _u
    open Cv.At.vectors as k0, k1
  {
    copy 32 nd <- key
    chunk_node(nd, p, 1024, counter, flags, plat)
      with k; (Hash.chunk bytes counter)
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Hash.Lv(lv, k, flags, Hash.nodes(k, flags, bytes, counter))
      keep Cv.At(key, k)
      keep Region(out, 32)
    node_out(cv, nd, 0, plat)
      with (Chunk.node k flags counter (Hash.chunk bytes counter))
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Hash.Lv(lv, k, flags, Hash.nodes(k, flags, bytes, counter))
      keep Cv.At(key, k)
      keep Region(out, 32)
    ladd(lv, key, flags, plat, cv)
      with k; (Hash.nodes k flags bytes counter); (Chunk.node k flags counter (Hash.chunk bytes counter))
      know Hash.cv_of
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Cv.At(key, k)
      keep Region(out, 32)
    p = p + 1024
    rem = rem - 1024
    counter = counter + 1
  }
  copy 32 nd <- key
  chunk_node(nd, p, rem, counter, flags, plat)
    with k; (Hash.chunk bytes counter)
    keep Hash.In(input, len, bytes, p, rem, counter)
    keep Hash.Lv(lv, k, flags, Hash.nodes(k, flags, bytes, counter))
    keep Cv.At(key, k)
    keep Region(out, 32)
  if counter == 0 {
    node_out(out, nd, ROOT, plat)
      with (Chunk.node k flags counter (Hash.chunk bytes counter))
      know Hash.one
  } else {
    node_out(cv, nd, 0, plat)
      with (Chunk.node k flags counter (Hash.chunk bytes counter))
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Hash.Lv(lv, k, flags, Hash.nodes(k, flags, bytes, counter))
      keep Cv.At(key, k)
      keep Region(out, 32)
    ladd(lv, key, flags, plat, cv)
      with k; (Hash.nodes k flags bytes counter); (Chunk.node k flags counter (Hash.chunk bytes counter))
      know Hash.cv_of
      know Hash.room
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Cv.At(key, k)
      keep Region(out, 32)
    lroot(out, lv, key, flags, plat, ROOT)
      with k; ((Hash.nodes k flags bytes counter).push (Chunk.node k flags counter (Hash.chunk bytes counter)))
      know Hash.many
  }
}

// ---- The fast path: wide kernels behind contracts (../lang/DESIGN.md, "The fast path") ----

// The table of addresses a wide kernel is given: lane j of the first n gets base + stride j, every lane
// past them base again (it hashes the first input once more; its result is not used). What fillp is
// claimed to do is Fillp.contract (../lang/Spec_fillp.lean).
fn fillp(ptrs, base, n, stride)
  meets Fillp.contract()
  uses Lemmas_fillp
  leave by Fillp.exit
{
  var i = 0
  var cur = base
  while i < 32
    invariant Ptrs.Mid(ptrs, base, n, stride, i, cur)   by Ptrs.Mid.real | Ptrs.Mid.dup   from Ptrs.Mid.start
    decreases 32 - i
  {
    if i < n { u64[ptrs + (i << 3)] = cur }
    else     { u64[ptrs + (i << 3)] = base }
    cur = cur + stride
    i = i + 1
  }
}

callee fillp at 0x110000 meets Fillp.contract by Proof_fillp.fillp_meets budget 64

// The library's 16-lane parent kernel (AVX-512) is not in this machine model. A function that calls it is
// proved over any program in which its address meets P16.contract (../lang/Spec_p16.lean): the theorem says
// so in a hypothesis. When examples run, p16s below stands at that address.
extern parents16/6 = "blake3_servil_avx512_p16"
callee parents16 at 0x18000 assumes P16.contract (11) budget 4096 standin p16s

// The stand-in: the same contract, one parent at a time through the one-block kernel. Tried on the
// contract's examples; not proved yet (a proof of it is the witness that the contract can be met).
fn p16s(inputs, blocks, key, counter, packed, out)
  meets P16.contract(k: Blake3.CV, base: BitVec 64, n: BitVec 64, flags: BitVec 64, l: List Blake3.CV)
{
  var f = packed & 255
  var i = 0
  var src = 0
  var dst = 0
  while i < 16 {
    src = u64[inputs + (i << 3)]
    dst = out + (i << 5)
    copy 32 dst <- key
    compress_avx512(dst, src, 64, 0, f)
    i = i + 1
  }
}

// The library's 32-lane chunk kernel, in the same way: K32.contract (../lang/Spec_k32.lean), and k32s in its
// place when examples run (every chunk's node by chunk_node, its value by node_out).
extern chunks32/6 = "blake3_servil_avx512_k32"
callee chunks32 at 0x10000 assumes K32.contract (11) budget 4096 standin k32s

fn k32s(inputs, blocks, key, counter, packed, out)
  meets K32.contract(k: Blake3.CV, base: BitVec 64, n: BitVec 64, flags: BitVec 64, bytes: List (BitVec 8))
{
  buf nd[120]
  var f = packed & 255
  var i = 0
  var src = 0
  var dst = 0
  var t = 0
  while i < 32 {
    src = u64[inputs + (i << 3)]
    dst = out + (i << 5)
    t = counter + i
    copy 32 nd <- key
    chunk_node(nd, src, 1024, t, f, AVX512)
    node_out(dst, nd, 0, AVX512)
    i = i + 1
  }
}

// The value of the tree over 32 chaining values (a wide kernel's 32 chunks): 16 parents, 8, 4, 2, 1, each
// level by the 16-lane parent kernel; its last call has one pair and writes that pair's parent in all sixteen
// lanes at res. What tree32 is claimed to do is Tree32.contract (../lang/Spec_tree32.lean).
fn tree32(res, cvs, key, flags)
  meets Tree32.contract(k: Blake3.CV, l: List Blake3.CV)
  uses Lemmas_tree32
  enter know Tree32.len
  leave by Tree32.exit
{
  buf ptrs[256]
  buf a[512]
  buf b[512]
  var pp = flags | 0x40000004            // PARENT, and a block length of 64 packed above the flags
  fillp(ptrs, cvs, 16, 64)
    keep Cv.At(key, k)
    keep Cvs32.At(cvs, l)
    keep Region(res, 512)
  parents16(ptrs, 1, key, 0, pp, a)
    with k; cvs; 16#64; flags; l
    know Tree32.in1
    keep Cv.At(key, k)
    keep Region(res, 512)
  fillp(ptrs, a, 8, 64)
    keep Cv.At(key, k)
    keep Cvs16.At(a, Tree32.l1(k, flags, l))
    keep Region(res, 512)
  parents16(ptrs, 1, key, 0, pp, b)
    with k; a; 8#64; flags; (Tree32.l1 k flags l)
    know Tree32.in2
    keep Cv.At(key, k)
    keep Region(res, 512)
  fillp(ptrs, b, 4, 64)
    keep Cv.At(key, k)
    keep Cvs16.At(b, Tree32.l2(k, flags, l))
    keep Region(res, 512)
  parents16(ptrs, 1, key, 0, pp, a)
    with k; b; 4#64; flags; ((Tree32.l2 k flags l).take 8)
    know Tree32.in3
    keep Cv.At(key, k)
    keep Region(res, 512)
  fillp(ptrs, a, 2, 64)
    keep Cv.At(key, k)
    keep Cvs16.At(a, Tree32.l3(k, flags, l))
    keep Region(res, 512)
  parents16(ptrs, 1, key, 0, pp, b)
    with k; a; 2#64; flags; ((Tree32.l3 k flags l).take 4)
    know Tree32.in4
    keep Cv.At(key, k)
    keep Region(res, 512)
  fillp(ptrs, b, 1, 64)
    keep Cv.At(key, k)
    keep Cvs16.At(b, Tree32.l4(k, flags, l))
    keep Region(res, 512)
  parents16(ptrs, 1, key, 0, pp, res)
    with k; b; 1#64; flags; ((Tree32.l4 k flags l).take 2)
    know Tree32.in5
}

callee tree32 at 0x120000 meets Tree32.contract by Proof_tree32.tree32_meets budget 8192

// The wide turns of a hash: while a whole group of 32 chunks has more of the message after it, the group's
// 32 values are made by the chunk kernel, their tree's value by tree32, and that value is added to levels
// over groups (ladd: the tree over the chunks is the tree over the groups' own trees, ../alg/Groups.lean).
// The result is how many chunks were taken. What wide is claimed to do is Wide.contract
// (../lang/Spec_wide.lean). For a machine with AVX-512.
fn wide(wl, input, len, key, flags)
  reg p, rem, counter, wl, key, flags
  meets Wide.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_wide
  leave by Wide.exit
{
  buf ptrs[256]
  buf cvs[1024]
  buf res[512]
  var kp = flags | 0x40020100           // the chunk's start and end flags and a last block of 64 bytes, packed above the mode's
  u64[wl] = 0
  var p = input
  var rem = len
  var counter = 0
  while rem > 32768
    invariant Hash.In(input, len, bytes, p, rem, counter)     by Wide.In.step32   from Hash.In.start
    invariant Wide.Lv(wl, k, flags, bytes, counter)           by Wide.Lv.step     from Wide.Lv.start
    invariant Cv.At(key, k)
    invariant kp == flags | 0x40020100
    decreases rem
  {
    fillp(ptrs, p, 32, 1024)
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Wide.Lv(wl, k, flags, bytes, counter)
      keep Cv.At(key, k)
    chunks32(ptrs, 16, key, counter, kp, cvs)
      with k; p; 32#64; flags; (Wide.group bytes counter)
      know Wide.k32in
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Wide.Lv(wl, k, flags, bytes, counter)
      keep Cv.At(key, k)
    tree32(res, cvs, key, flags)
      with k; (K32.values k flags counter 32#64 (Wide.group bytes counter))
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Wide.Lv(wl, k, flags, bytes, counter)
      keep Cv.At(key, k)
    ladd(wl, key, flags, AVX512, res)
      with k; (Wide.units k flags bytes counter.toNat); (Wide.unit k flags bytes (counter.toNat / 32))
      know Wide.unit_cv
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Cv.At(key, k)
    p = p + 32768
    rem = rem - 32768
    counter = counter + 32
  }
  return counter
}

callee wide at 0x130000 meets Wide.contract by Proof_wide.wide_meets budget 16384

// The first n of the 32 values at cvs (a wide kernel's, for the chunks of a last, short group) are added to
// the levels, one after another. What addn is claimed to do is Addn.contract (../lang/Spec_addn.lean).
fn addn(lv, key, flags, cvs, n)
  reg i, p, lv, key, flags, n
  meets Addn.contract(k: Blake3.CV, chunks: Array Blake3.Node, news: List Blake3.Node, vals: List Blake3.CV)
  uses Lemmas_addn
  leave by Addn.exit
{
  var i = 0
  var p = cvs
  while i < n
    invariant Addn.Mid(lv, cvs, k, flags, chunks, news, vals, n, i, p)   by Addn.Mid.step   from Addn.Mid.start
    invariant Cv.At(key, k)
    decreases n - i
  {
    ladd(lv, key, flags, AVX512, p)
      with k; (chunks ++ (news.take i.toNat).toArray); (news.getD i.toNat default)
      know Addn.Mid.next
      keep Cv.At(key, k)
      keep Cvs32.At(cvs, vals)
    p = p + 32
    i = i + 1
  }
}

callee addn at 0x160000 meets Addn.contract by Proof_addn.addn_meets budget 512

// The root, from levels over a message's whole groups (wl) and levels over its last group's chunks (lv); sel
// says which case it is (the caller knows: 0, no whole group; 1, whole groups and a last group of one chunk;
// 2, of two or more). With no whole group the root is the last group's own. Otherwise the last group's value
// (its only chunk's, waiting in the bottom level's first place, or the top of its levels, not as a root) is
// added to the groups' levels, whose root is the message's. What finish is claimed to do is Finish.contract
// (../lang/Spec_finish.lean).
fn finish(out, wl, lv, key, flags, sel)
  meets Finish.contract(k: Blake3.CV, units: Array Blake3.Node, tail: Array Blake3.Node)
  uses Lemmas_finish
  leave by Finish.exit
{
  buf cv[32]
  var bottom = lv + 64                  // the bottom level's first place
  if sel == 0 {
    lroot(out, lv, key, flags, AVX512, ROOT)
      with k; tail
      know Finish.none
      keep Hash.Lv(wl, k, flags, units)
  } else {
    if sel == 1 {
      ladd(wl, key, flags, AVX512, bottom)
        with k; units; (tail[0]!)
        know Finish.one
        keep Cv.At(key, k)
        keep Region(out, 32)
      lroot(out, wl, key, flags, AVX512, ROOT)
        with k; (Finish.w1 units tail)
        know Finish.one_root
        keep Hash.Lv(wl, k, flags, Finish.w1(units, tail))
    } else {
      lroot(cv, lv, key, flags, AVX512, 0)
        with k; tail
        know Finish.many
        keep Hash.Lv(wl, k, flags, units)
        keep Cv.At(key, k)
        keep Region(out, 32)
      ladd(wl, key, flags, AVX512, cv)
        with k; units; (Blake3.tree k ⟨flags.setWidth 32⟩ tail)
        know Finish.sub
        keep Cv.At(key, k)
        keep Region(out, 32)
      lroot(out, wl, key, flags, AVX512, ROOT)
        with k; (Finish.w2 k flags units tail)
        know Finish.many_root
        keep Hash.Lv(wl, k, flags, Finish.w2(k, flags, units, tail))
    }
  }
}

callee finish at 0x170000 meets Finish.contract by Proof_finish.finish_meets budget 1024

// The chunks of some bytes of a message (a last group), numbered from cfirst, into levels: hashl's loop, each
// chunk's node by chunk_node and its value by node_out, and the last chunk too (it is not a root here: the
// caller makes the root, finish). What group is claimed to do is Group.contract (../lang/Spec_group.lean).
fn group(lv, input, len, key, flags, cfirst)
  reg p, rem, counter, key, flags, lv
  meets Group.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_group
  leave open Group.last as _u
  leave open Cv.At.vectors as k0, k1
  leave by Group.exit
{
  buf nd[120]
  buf cv[32]
  u64[lv] = 0
  var p = input
  var rem = len
  var counter = 0
  while rem > 1024
    invariant Hash.In(input, len, bytes, p, rem, counter)                             by Hash.In.step    from Hash.In.start
    invariant Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, counter))       by Group.Lv.step   from Group.Lv.start
    invariant Cv.At(key, k)
    decreases rem
    open Group.turn as _u
    open Cv.At.vectors as k0, k1
  {
    var t = cfirst + counter
    copy 32 nd <- key
    chunk_node(nd, p, 1024, t, flags, AVX512)
      with k; (Hash.chunk bytes counter)
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, counter))
      keep Cv.At(key, k)
    node_out(cv, nd, 0, AVX512)
      with (Chunk.node k flags (cfirst + counter) (Hash.chunk bytes counter))
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, counter))
      keep Cv.At(key, k)
    ladd(lv, key, flags, AVX512, cv)
      with k; (Group.nodesTo k flags cfirst bytes counter); (Chunk.node k flags (cfirst + counter) (Hash.chunk bytes counter))
      know Hash.cv_of
      keep Hash.In(input, len, bytes, p, rem, counter)
      keep Cv.At(key, k)
    p = p + 1024
    rem = rem - 1024
    counter = counter + 1
  }
  var tl = cfirst + counter
  copy 32 nd <- key
  chunk_node(nd, p, rem, tl, flags, AVX512)
    with k; (Hash.chunk bytes counter)
    keep Hash.In(input, len, bytes, p, rem, counter)
    keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, counter))
    keep Cv.At(key, k)
  node_out(cv, nd, 0, AVX512)
    with (Chunk.node k flags (cfirst + counter) (Hash.chunk bytes counter))
    keep Hash.In(input, len, bytes, p, rem, counter)
    keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, counter))
    keep Cv.At(key, k)
  ladd(lv, key, flags, AVX512, cv)
    with k; (Group.nodesTo k flags cfirst bytes counter); (Chunk.node k flags (cfirst + counter) (Hash.chunk bytes counter))
    know Hash.cv_of
    know Group.all
}

callee group at 0x180000 meets Group.contract by Proof_group.group_meets budget 1024

// The last group, fast: what group does (Group.contract), for more than one chunk and at most 32. Every
// chunk but the last goes through the chunk kernel in one call (the lanes past them hash the first chunk
// again, unused), their values are added to the levels (addn), and the last chunk, which may be short, is
// made as group makes it. What groupf is claimed to do is Groupf.contract (../lang/Spec_groupf.lean).
fn groupf(lv, input, len, key, flags, cfirst)
  meets Groupf.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_groupf
  enter know Groupf.msg
  leave by Group.exit
{
  buf nd[120]
  buf cv[32]
  buf ptrs[256]
  buf cvs[1024]
  var kp = flags | 0x40020100           // the chunk's start and end flags and a last block of 64 bytes, packed above the mode's
  var w = (len - 1) >> 10               // the chunks before the last: 1 to 31
  var p = input + (w << 10)
  var r = len - (w << 10)
  var tl = cfirst + w
  fillp(ptrs, input, w, 1024)
    keep Hash.In(input, len, bytes, input, len, 0)
    keep Cv.At(key, k)
    keep Region(lv, 3520)
  chunks32(ptrs, 16, key, cfirst, kp, cvs)
    with k; input; $w; flags; (Groupf.head bytes $w)
    know Groupf.k32in
    keep Hash.In(input, len, bytes, input, len, 0)
    keep Cv.At(key, k)
    keep Region(lv, 3520)
  u64[lv] = 0
  addn(lv, key, flags, cvs, w)
    with k; (#[] : Array Blake3.Node); (Groupf.news k flags cfirst bytes $w); (K32.values k flags cfirst $w (Groupf.head bytes $w))
    know Groupf.addin (k := k) (flags := flags) (c0 := cfirst) (bytes := bytes)
    keep Hash.In(input, len, bytes, input, len, 0)
    keep Cv.At(key, k)
  copy 32 nd <- key
  chunk_node(nd, p, r, tl, flags, AVX512)
    open Cv.At.vectors as k0, k1
    with k; (Hash.chunk bytes $w)
    know Groupf.after
    keep Hash.In(input, len, bytes, p, r, w)
    keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, w))
    keep Cv.At(key, k)
  node_out(cv, nd, 0, AVX512)
    with (Chunk.node k flags (cfirst + $w) (Hash.chunk bytes $w))
    keep Hash.In(input, len, bytes, p, r, w)
    keep Hash.Lv(lv, k, flags, Group.nodesTo(k, flags, cfirst, bytes, w))
    keep Cv.At(key, k)
  ladd(lv, key, flags, AVX512, cv)
    with k; (Group.nodesTo k flags cfirst bytes $w); (Chunk.node k flags (cfirst + $w) (Hash.chunk bytes $w))
    know Hash.cv_of
    know Group.all
}

callee groupf at 0x1B0000 meets Groupf.contract by Proof_groupf.groupf_meets budget 8192

callee hashl at 0x40000 meets Hashl.contract by Proof_hashl.hashl_meets budget 4608

// The whole hash for a machine with AVX-512: a message of more than a chunk goes by groups of 32 chunks
// through the wide kernels (wide), its last group through the chunk kernel too but for its last chunk
// (groupf; a last group of one chunk by group), and finish makes the root from the two sets of levels; a
// message of one chunk goes to hashl. What hashw is claimed to do is
// Hashw.contract (../lang/Spec_hashw.lean): what hashl does. The tree's part is ../alg/Groups.lean.
fn hashw(out, input, len, key, flags)
  meets Hashw.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_hashw
  enter know Hashw.msg
  leave by Hashl.exit
{
  buf wl[3520]
  buf lv[3520]
  if len > 1024 {
    var c = wide(wl, input, len, key, flags)
      with k; bytes
      keep Hash.In(input, len, bytes, input, len, 0)
      keep Cv.At(key, k)
      keep Region(out, 32)
    var p = input + (c << 10)
    var rem = len - (c << 10)
    if c == 0 {
      groupf(lv, p, rem, key, flags, c)
        with k; (Hashw.rest bytes)
        know Hashw.tailin
        keep Hash.Lv(wl, k, flags, Hashw.units(k, flags, bytes))
        keep Cv.At(key, k)
        keep Region(out, 32)
      finish(out, wl, lv, key, flags, 0)
        with k; (Hashw.units k flags bytes); (Group.nodes k flags $c (Hashw.rest bytes))
        know Hashw.way0
    } else {
      if rem > 1024 {
        groupf(lv, p, rem, key, flags, c)
          with k; (Hashw.rest bytes)
          know Hashw.tailin
          keep Hash.Lv(wl, k, flags, Hashw.units(k, flags, bytes))
          keep Cv.At(key, k)
          keep Region(out, 32)
        finish(out, wl, lv, key, flags, 2)
          with k; (Hashw.units k flags bytes); (Group.nodes k flags $c (Hashw.rest bytes))
          know Hashw.way2
      } else {
        group(lv, p, rem, key, flags, c)
          with k; (Hashw.rest bytes)
          know Hashw.tailin
          keep Hash.Lv(wl, k, flags, Hashw.units(k, flags, bytes))
          keep Cv.At(key, k)
          keep Region(out, 32)
        finish(out, wl, lv, key, flags, 1)
          with k; (Hashw.units k flags bytes); (Group.nodes k flags $c (Hashw.rest bytes))
          know Hashw.way1
      }
    }
  } else {
    hashl(out, input, len, key, flags, AVX512)
      with k; bytes
      know Hashw.same
  }
}

callee hashw at 0x190000 meets Hashw.contract by Proof_hashw.hashw_meets budget 32768

// The fast hash: hashw where the machine has AVX-512, hashl elsewhere. What hashf is claimed to do is
// Hashf.contract (../lang/Spec_hashw.lean): what hashl does.
fn hashf(out, input, len, key, flags, plat)
  meets Hashf.contract(k: Blake3.CV, bytes: List (BitVec 8))
  uses Lemmas_hashw
  enter know Hashw.msg
  leave by Hashl.exit
{
  if plat == AVX512 {
    hashw(out, input, len, key, flags)
      with k; bytes
      know Hashw.same
  } else {
    hashl(out, input, len, key, flags, plat)
      with k; bytes
      know Hashw.same
  }
}

def fill_ptrs(base, shift, count) {
  i = 0
  while i < count {
    u64[ptrs + (i << 3)] = base + (i << shift)
    i = i + 1
  }
}

// The whole hash on the levels (hasher.ode's `hash` without its 32-chunk path): every chunk's value is
// added, the last one too; one chunk alone is the root itself.
fn hash2(out, input, len, key, flags, plat)
  reg p, rem, counter, i, n, key
{
  buf lv[3520] align 64
  buf cvs[1024]
  buf ptrs[256]
  buf block[64]
  buf cv[32]
  buf blk[64]
  buf acc[32]
  var p = input
  var rem = len
  var counter = 0
  var pf = flags | PARENT
  var i = 0
  var n = 0
  var t = 0
  var f = 0
  var ln = 0
  var x = 0
  var e = 0
  var src = 0
  var dst = 0
  var base = 0
  u64[lv] = 0

  // Whole chunks, up to sixteen at a time, while more than one chunk's bytes are left.
  while rem > 1024 {
    n = rem >> 10
    if n > 16 { n = 16 }
    fill_ptrs(p, 10, n)
    if plat == AVX512 { hash_many_avx512(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) }
    else { if plat == AVX2 { hash_many_avx2(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) }
           else            { hash_many_sse41(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) } }
    p = p + (n << 10)
    rem = rem - (n << 10)
    i = 0
    while i < n {
      t = cvs + (i << 5)
      levels_add()
      i = i + 1
    }
    counter = counter + n
  }

  // What is left: the only chunk (it is the root), or the last one if bytes are left.
  var one = 0
  if counter == 0 { one = 1 }
  var tail = one
  if rem != 0 { tail = 1 }
  if tail == 1 {
    copy 32 cv <- key
    var first = CHUNK_START
    while rem > 64 {
      f = flags | first
      compress(cv, p, 64, counter, f)
      first = 0
      p = p + 64
      rem = rem - 64
    }
    var lastp = p
    if rem != 64 {
      for k8 in 0..8 { u64[block + (k8 << 3)] = 0 }
      var jj = 0
      while jj < rem {
        u8[block + jj] = u8[p + jj]
        jj = jj + 1
      }
      lastp = block
    }
    f = flags | first | CHUNK_END
    if one == 1 { f = f | ROOT }
    compress(cv, lastp, rem, counter, f)
  }
  if one == 1 { copy 32 out <- cv }
  else {
    if tail == 1 {
      t = cv
      levels_add()
    }
    levels_root()
  }
}
