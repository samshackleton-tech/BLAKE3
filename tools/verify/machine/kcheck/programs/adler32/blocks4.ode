// Adler-32 with the sums brought below 65521 once in 5552 bytes, four bytes a turn: blocks.ode with its
// inner loop written out four times, to see what the compiler's loop costs.
fn adler32_blocks4(input, n)
  reg input, n, i, a, b, end
{
  var i = 0
  var a = 1
  var b = 0
  var end = 0
  while i < n {
    end = n
    if n - i > 5552 { end = i + 5552 }
    while end - i > 3 {
      a = a + u8[input + i]
      b = b + a
      a = a + u8[input + i + 1]
      b = b + a
      a = a + u8[input + i + 2]
      b = b + a
      a = a + u8[input + i + 3]
      b = b + a
      i = i + 4
    }
    while i < end {
      a = a + u8[input + i]
      b = b + a
      i = i + 1
    }
    a = (a & 65535) + ((a >> 16) << 4) - (a >> 16)
    a = (a & 65535) + ((a >> 16) << 4) - (a >> 16)
    if a >= 65521 { a = a - 65521 }
    b = (b & 65535) + ((b >> 16) << 4) - (b >> 16)
    b = (b & 65535) + ((b >> 16) << 4) - (b >> 16)
    if b >= 65521 { b = b - 65521 }
  }
  return (b << 16) + a
}
