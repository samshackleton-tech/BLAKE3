// Whether n bytes are well-formed UTF-8, and how many code points they hold: written to be proved against
// utf8.spec. It gives the count, or NO.
//
// It looks at a sequence in the specification's order: the first byte, and how many bytes it begins; then
// each byte after it (is it there? is it 0x80 to 0xBF?); and only then whether the number held is one the
// sequence's length is the fewest bytes for, is no surrogate, and is not above 0x10FFFF. Those three it tells from the first two
// bytes: 0xC0 and 0xC1 begin only numbers below 0x80; after 0xE0 a byte below 0xA0 gives a number below
// 0x800, after 0xED one from 0xA0 a surrogate; after 0xF0 a byte below 0x90 gives a number below 0x10000,
// after 0xF4 one from 0x90, and anything after 0xF5 to 0xF7, a number above 0x10FFFF.
//
// state: 0 going on, 1 the bytes are all looked at, 2 not well-formed.
const NO = 0xFFFFFFFFFFFFFFFF

fn utf8(input, n)
  reg input, n, i, count, b, c1
{
  var i = 0
  var count = 0
  var b = 0
  var c1 = 0
  var c = 0
  var need = 0
  var state = 0
  while state == 0 {
    if i >= n { state = 1 } else {
      b = u8[input + i]
      if b < 128 {
        i = i + 1
        count = count + 1
      } else {
        if b < 192 { state = 2 } else {
          if b >= 248 { state = 2 } else {
            need = 2
            if b >= 224 { need = 3 }
            if b >= 240 { need = 4 }
            // the byte after the first
            if i + 1 >= n { state = 2 } else {
              c1 = u8[input + i + 1]
              if c1 < 128 { state = 2 } else { if c1 >= 192 { state = 2 } }
            }
            // the third byte of three or four
            if state == 0 {
              if need >= 3 {
                if i + 2 >= n { state = 2 } else {
                  c = u8[input + i + 2]
                  if c < 128 { state = 2 } else { if c >= 192 { state = 2 } }
                }
              }
            }
            // the fourth of four
            if state == 0 {
              if need >= 4 {
                if i + 3 >= n { state = 2 } else {
                  c = u8[input + i + 3]
                  if c < 128 { state = 2 } else { if c >= 192 { state = 2 } }
                }
              }
            }
            // the number held
            if state == 0 {
              if need < 3 {
                if b < 194 { state = 2 } else {
                  i = i + 2
                  count = count + 1
                }
              } else {
                if need < 4 {
                  if b == 224 {
                    if c1 < 160 { state = 2 }
                  } else {
                    if b >= 237 {
                      if b < 238 {
                        if c1 >= 160 { state = 2 }
                      }
                    }
                  }
                  if state == 0 {
                    i = i + 3
                    count = count + 1
                  }
                } else {
                  if b == 240 {
                    if c1 < 144 { state = 2 }
                  } else {
                    if b >= 244 {
                      if b < 245 {
                        if c1 >= 144 { state = 2 }
                      } else { state = 2 }
                    }
                  }
                  if state == 0 {
                    i = i + 4
                    count = count + 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  var result = NO
  if state == 1 { result = count }
  return result
}
