// Sigil 0.1 (github.com/johnservil/sigil, README.md "The encoding"): what the sigil of some bytes is, and
// the public contract of the binary's encoder of 32 bytes.
//
// "The data, with the marker bits 01 between its high and low halves, is multiplied by a prime K larger than
// N and written in base N = 2,048, 11 bits a letter, in n = ceil((8 * length + 14) / 11) letters."

const N = 2048

// The number that bytes write, the first byte the most significant.
def number(bytes) {
    let w[0] = 0
    let w[i + 1] = 256 * w[i] + bytes[i]
    w[len(bytes)]
}

// The letters of a sigil of L bytes, and the check prime K of the room they leave (2^12 to 2^22).
def letters(L) { (8 * L + 14 + 10) / 11 }
const CHECK_PRIMES = [4093, 8179, 16381, 32749, 65519, 131063, 262133, 524269, 1048433, 2096881, 4193633]
def check_prime(L) { CHECK_PRIMES[11 * letters(L) - 8 * L - 2 - 12] }

// The data's number d with the two marker bits 01 between its high and low halves of 4 L bits.
def marked(L, d) { (4 * (d / pow(2, 4 * L)) + 1) * pow(2, 4 * L) + d % pow(2, 4 * L) }

// w as n digits in base N, the first the most significant.
def digits(w, n) { [w / pow(N, n - 1 - k) % N for k in 0..n] }

// The sigil of some bytes (at least one), as code points: digit k as ALPHABET[k].
def sigil(bytes) {
    let L = len(bytes)
    let d = digits(marked(L, number(bytes)) * check_prime(L), letters(L))
    [ALPHABET[d[k]] for k in 0..letters(L)]
}

// A code point from U+0800 to U+FFFF (every letter is one) as its three bytes of UTF-8.
def utf8(p) { [224 + p / 4096, 128 + p / 64 % 64, 128 + p % 64] }
def sigil_utf8(bytes) { [utf8(sigil(bytes)[k / 3])[k % 3] for k in 0..3 * letters(len(bytes))] }

