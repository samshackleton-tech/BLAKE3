// The Internet checksum of n bytes, written to be proved against inet.spec. Of 2^49 bytes or more (their
// plain sum might not fit 64 bits) it says NO. No branch and no address depends on the bytes: only on n.
const NO = 0xFFFFFFFFFFFFFFFF

fn inet(input, n)
  reg input, n, i, s
{
  var i = 0
  var s = 0
  var result = NO
  // n < 2^49, asked as the verifier can follow it today: it reads no constant above 32 bits and no shift
  // by more than 16
  if (((n >> 16) >> 16) >> 16) >> 1 == 0 {
    while n - i > 1 {
      s = s + (u8[input + i] << 8) + u8[input + i + 1]
      i = i + 2
    }
    if n - i == 1 { s = s + (u8[input + i] << 8) }
    s = (s & 65535) + (s >> 16)
    s = (s & 65535) + (s >> 16)
    s = (s & 65535) + (s >> 16)
    s = (s & 65535) + (s >> 16)
    result = 65535 - s
  }
  return result
}
