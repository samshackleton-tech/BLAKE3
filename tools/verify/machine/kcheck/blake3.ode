// BLAKE3, as a specification that runs.
//
// This file is what a reader checks the code against. It is read two ways by one small program (ode.py):
//   on numbers   `blake3`, `blake3_keyed` and `blake3_derive_key` below must give the official test vectors
//                (test_vectors/test_vectors.json: every length, the three modes);
//   on symbols   `compress`, the machines `chunk` and `merge`, and `parent` give the terms the checkers
//                (kcheck.py, kloop.py, kglue.py) compare a function's machine code with.
//
// The language: numbers (whole, not below zero), words (32 bits: `+` wraps, `^`, `|`, `>>>` rotates right),
// 64-bit counters (`+` a number wraps at 64 bits; `lo`, `hi` are its words), lists (`[a, b]`, `xs[i]`,
// `xs[a..b]`, `xs ++ ys`, `len(xs)`, `[e for i in a..b]`), `if c then a else b`. A `fn` is a pure function:
// `var` is a local that may be assigned, and assigning `xs[i] = e` makes a new list. A `machine` is a loop
// over a state: `turn` is one step. Code is proved by its loop matching a machine turn for turn.

const IV = [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]
const PERMUTATION = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]

const CHUNK_START         = 1
const CHUNK_END           = 2
const PARENT              = 4
const ROOT                = 8
const KEYED_HASH          = 16
const DERIVE_KEY_CONTEXT  = 32
const DERIVE_KEY_MATERIAL = 64

// ---------------------------------------------------------------------------------------------------------
// The compression function (the BLAKE3 paper, section 2.2).

fn g(s, a, b, c, d, x, y) {
    var v = s
    v[a] = v[a] + v[b] + x
    v[d] = (v[d] ^ v[a]) >>> 16
    v[c] = v[c] + v[d]
    v[b] = (v[b] ^ v[c]) >>> 12
    v[a] = v[a] + v[b] + y
    v[d] = (v[d] ^ v[a]) >>> 8
    v[c] = v[c] + v[d]
    v[b] = (v[b] ^ v[c]) >>> 7
    v
}

fn round(s, m) {
    var v = s
    v = g(v, 0, 4, 8, 12, m[0], m[1])
    v = g(v, 1, 5, 9, 13, m[2], m[3])
    v = g(v, 2, 6, 10, 14, m[4], m[5])
    v = g(v, 3, 7, 11, 15, m[6], m[7])
    v = g(v, 0, 5, 10, 15, m[8], m[9])
    v = g(v, 1, 6, 11, 12, m[10], m[11])
    v = g(v, 2, 7, 8, 13, m[12], m[13])
    v = g(v, 3, 4, 9, 14, m[14], m[15])
    v
}

// h: the chaining value, 8 words. m: the block, 16 words. t: the counter, 64 bits. length: the block's bytes.
// flags: the domain flags. The result: the new chaining value, 8 words.
fn compress(h, m, t, length, flags) {
    var s = h ++ [word(IV[0]), word(IV[1]), word(IV[2]), word(IV[3]), lo(t), hi(t), word(length), word(flags)]
    var w = m
    for r in 0..7 {
        s = round(s, w)
        w = [w[PERMUTATION[i]] for i in 0..16]
    }
    [s[i] ^ s[i + 8] for i in 0..8]
}

// ---------------------------------------------------------------------------------------------------------
// A chunk (section 2.4): its blocks are compressed one after another from the key; the first carries the
// start flag, the last the end flag and its own length. `input` is the chunk's n blocks; `start`, `end` and
// `length` are what the first and the last block are given (for a chunk of a file: CHUNK_START, CHUNK_END,
// and ROOT with it when the chunk is the whole file).
machine chunk(key, t, flags, start, end, length, n, input) on h = key {
    for b in 0..n
    turn {
        h = compress(h, input[b], t,
                     if b == n - 1 then length else 64,
                     flags | (if b == 0 then start else 0) | (if b == n - 1 then end else 0))
    }
}

// A parent node (section 2.5): one block, the two children's chaining values.
fn parent(key, flags, left, right) {
    compress(key, left ++ right, counter(0), 64, flags | PARENT)
}

// The stack of chaining values of the subtrees finished so far: while it holds more than `target`, its two
// newest become their parent. (That this is BLAKE3's tree is proved of the same machine in alg/Stack.lean.)
machine merge(key, flags, target) on s {
    while len(s) > target
    turn {
        s = s[0..len(s) - 2] ++ [parent(key, flags, s[len(s) - 2], s[len(s) - 1])]
    }
}

// ---------------------------------------------------------------------------------------------------------
// What functions of the binary are claimed to do (so far: the one-block kernels and the hasher's stack; the
// wide kernels' claims are still in kloop.py and kcheck.py). The arguments are in the order the machine's
// calling convention passes them. An argument is the address of a `stack` of chaining values (1792 bytes: its
// count in the first 8, value i at 32 + 32*i, at most 55 of them), the address of a `cv` (32 bytes: 8 words)
// or of a `block` (64 bytes: 16 words), a `byte` (a number below 256), a `number`, a `counter` (64 bits), or
// `any` 64 bits; `low byte`, `word` (a number below 2^32) and `low word` say how much of a register a kernel
// reads. `asks`: what a caller must show. `leaves`: what the memory named holds afterwards; all else is as it
// was. `returns`: the result. `stack`: the bytes of stack the function may use below its return address.
// `calls F if C`: the function calls F only where C holds (the platform word 5 means the machine has AVX-512,
// which its caller answers for).

contract blake3_servil_compress_in_place_avx512(h: cv, m: block, length: low byte, t: counter, flags: low byte) {
    leaves h = compress(h, m, t, length, flags)
    stack 0
}

contract blake3_servil_compress_in_place_sse41(h: cv, m: block, length: word, t: counter, flags: low word) {
    leaves h = compress(h, m, t, length, flags)
    stack 0
}

contract b3l_push(st: stack, new: cv) {
    asks len(st) <= 54
    leaves st = st ++ [new]
    stack 64
}

contract b3l_merge(st: stack, key: cv, flags: byte, plat: any, target: number) {
    asks target >= 1
    leaves st = merge(key, flags, target, st)
    returns len(st)
    stack 256
    calls blake3_servil_compress_in_place_avx512 if plat == 5
}

contract b3l_add(st: stack, key: cv, flags: byte, plat: any, new: cv, target: number) {
    asks len(st) <= 54
    asks target >= 1
    leaves st = merge(key, flags, target, st ++ [new])
    returns len(st)
    stack 512
}

// ---------------------------------------------------------------------------------------------------------
// The whole hash of a message of bytes (run on numbers only: the test vectors).

fn words(bytes) {
    [word(bytes[4 * i] + 256 * bytes[4 * i + 1] + 65536 * bytes[4 * i + 2] + 16777216 * bytes[4 * i + 3]) for i in 0..len(bytes) / 4]
}

// A chunk's bytes as whole blocks, the last padded with zeros; a chunk of no bytes is one block.
fn blocks(bytes) {
    let n = if len(bytes) == 0 then 1 else (len(bytes) + 63) / 64
    let padded = bytes ++ [0 for i in len(bytes)..64 * n]
    [words(padded[64 * b..64 * b + 64]) for b in 0..n]
}

fn last_length(bytes) {
    if len(bytes) == 0 then 0 else len(bytes) - 64 * ((len(bytes) + 63) / 64 - 1)
}

fn chunk_value(key, index, flags, end, bytes) {
    let bs = blocks(bytes)
    chunk(key, counter(index), flags, CHUNK_START, end, last_length(bytes), len(bs), bs)
}

// The hash's eight words: the message's chunks of 1024 bytes go on the stack one by one, merged down to as
// many values as the count of chunks so far has one bits; at the end all are merged, the last parent as ROOT.
fn hash_words(key, flags, message) {
    let chunks = if len(message) == 0 then 1 else (len(message) + 1023) / 1024
    if chunks == 1 { return chunk_value(key, 0, flags, CHUNK_END | ROOT, message) }
    var s = []
    for i in 0..chunks {
        let from = 1024 * i
        let to = if i == chunks - 1 then len(message) else from + 1024
        s = s ++ [chunk_value(key, i, flags, CHUNK_END, message[from..to])]
        if i < chunks - 1 { s = merge(key, flags, ones(i + 1), s) }
    }
    s = merge(key, flags, 2, s)
    parent(key, flags | ROOT, s[0], s[1])
}

fn bytes_of(ws) {
    var out = []
    for i in 0..len(ws) { out = out ++ word_bytes(ws[i]) }
    out
}

fn blake3(message) { bytes_of(hash_words(words_of_iv(), 0, message)) }
fn blake3_keyed(key_bytes, message) { bytes_of(hash_words(words(key_bytes), KEYED_HASH, message)) }
fn blake3_derive_key(context, material) {
    let context_key = hash_words(words_of_iv(), DERIVE_KEY_CONTEXT, context)
    bytes_of(hash_words(context_key, DERIVE_KEY_MATERIAL, material))
}
fn words_of_iv() { [word(IV[i]) for i in 0..8] }
