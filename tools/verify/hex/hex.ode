// The hash's hexadecimal, as two kernels: the source the shipped assembly is printed from
// (c/blake3_hex_x86-64_unix.S, c/blake3_hex_aarch64.S) and the proofs are about. See README.md.
//
// `data NAME = ...` is a constant in read-only memory (`#NAME` in a kernel). `kernel NAME { ... }` is
// x86-64 assembly (Intel syntax), `kernel NAME on aarch64 { ... }` AArch64's; `def` is a macro, `$x` its
// argument. `contract` says, for the proof generator, where the kernel reads and what it writes.

data nib   = 0x0F0F0F0F, 0x0F0F0F0F, 0x0F0F0F0F, 0x0F0F0F0F
data nine  = 0x09090909, 0x09090909, 0x09090909, 0x09090909
data alpha = 0x27272727, 0x27272727, 0x27272727, 0x27272727      // 'a' - '0' - 10
data zero  = 0x30303030, 0x30303030, 0x30303030, 0x30303030      // '0'

// The 64 hexadecimal characters of the 32 bytes at RSI, written at RDI. Sixteen bytes at a time:
// the high and low four bits of each byte, interleaved, then each made its character by adding '0',
// and 39 more where it is above 9. No table, no branch: nothing an observer sees depends on the bytes.
contract hex {
  spec   HexSpec
  reads  rsi: h0, h1
  writes rdi: Hex.hex8 h0 0, Hex.hex8 h0 8, Hex.hex8 h1 0, Hex.hex8 h1 8
}
kernel hex {
  // The numbers in $x become their characters. XMM4 is scratch.
  def chars(x) {
    movdqa  xmm4, $x
    pcmpgtb xmm4, xmm6
    pand    xmm4, xmm7
    paddb   $x, xmm4
    paddb   $x, xmm8
  }
  // The sixteen bytes in $x become 32 characters at RDI + $at. XMM2 and XMM3 are scratch.
  def half(x, at) {
    movdqa  xmm2, $x
    psrlw   xmm2, 4
    pand    xmm2, xmm5
    pand    $x, xmm5
    movdqa  xmm3, xmm2
    punpcklbw xmm3, $x
    punpckhbw xmm2, $x
    chars(xmm3)
    chars(xmm2)
    movdqu  xmmword ptr [rdi + $at], xmm3
    movdqu  xmmword ptr [rdi + $at + 16], xmm2
  }
  movdqu  xmm0, xmmword ptr [rsi]
  movdqu  xmm1, xmmword ptr [rsi + 16]
  movdqa  xmm5, xmmword ptr [rip + #nib]
  movdqa  xmm6, xmmword ptr [rip + #nine]
  movdqa  xmm7, xmmword ptr [rip + #alpha]
  movdqa  xmm8, xmmword ptr [rip + #zero]
  half(xmm0, 0)
  half(xmm1, 32)
  ret
}

// The same on AArch64 (NEON): the 32 bytes at X1, their 64 hexadecimal characters at X0. Each byte is split
// in its two halves and each half's character is looked up (`tbl`) in a register that holds the sixteen
// characters. That register is made from immediates through X9 and X10: there is no table in memory, no
// constant loaded, no branch. V0-V5 and V16-V19, X9 and X10 only (all caller-saved); no stack.
// (Before November 13 the characters were made by arithmetic, 32 instructions: a call took 9.8 ns on a
// Neoverse where this takes 7.9; on an Apple M6 the two are within 0.1 ns.)
contract hex_neon {
  spec   HexVec
  reads  x1: h0, h1
  writes x0: Hex.hex16 h0 0, Hex.hex16 h0 8, Hex.hex16 h1 0, Hex.hex16 h1 8
}
kernel hex_neon on aarch64 {
  // The sixteen bytes in $x, each split in its high and low four bits: the high in $hi, the low in $x.
  def split(x, hi) {
    ushr    $hi.16b, $x.16b, #4
    and     $x.16b, $x.16b, v4.16b
  }
  // The numbers in $x (0 to 15) become their characters.
  def chars(x) {
    tbl     $x.16b, {v5.16b}, $x.16b
  }
  ldp     q0, q1, [x1]
  // "01234567" and "89abcdef", the first character lowest
  movz    x9, #0x3130
  movk    x9, #0x3332, lsl #16
  movk    x9, #0x3534, lsl #32
  movk    x9, #0x3736, lsl #48
  movz    x10, #0x3938
  movk    x10, #0x6261, lsl #16
  movk    x10, #0x6463, lsl #32
  movk    x10, #0x6665, lsl #48
  mov     v5.d[0], x9
  mov     v5.d[1], x10
  movi    v4.16b, #0x0f
  split(v0, v2)
  split(v1, v3)
  zip1    v16.16b, v2.16b, v0.16b
  zip2    v17.16b, v2.16b, v0.16b
  zip1    v18.16b, v3.16b, v1.16b
  zip2    v19.16b, v3.16b, v1.16b
  chars(v16)
  chars(v17)
  chars(v18)
  chars(v19)
  stp     q16, q17, [x0]
  stp     q18, q19, [x0, #32]
  ret
}
