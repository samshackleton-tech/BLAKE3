=== ode-helpers ===
order: h0 h1 h2 h3 ode_avm3xn6iebmbbyfw5zhoxrykide7d4fsfr64ghjslzl4bypdoyia
layout m2__parent104 104 {
    r0: cv at 0,
    r1: 32 bytes at 32,
    r2: cv at 64,
    r3: byte at 96
}

contract h2(h: cv, m: block, length: word, t: counter, flags: low word) {
    requires no_overlap(h, m)
    ensures h = f2(h, m, t, length, flags)
    trace depends on nothing
    stack 0
}

contract h0(dst: 32 bytes, src: m bytes, m: number) {
    requires no_overlap(dst, src)
    requires m <= 32
    ensures dst = f6(src)
    trace depends on m
    stack 0
}

contract h3(out: cv, nd: m2__parent104, extra: byte) {
    requires no_overlap(out, nd)
    ensures out = f1(nd, extra)
    trace depends on nothing
    stack 0
}

contract h1(nd: m2__parent104, left: m bytes, m: number, right: cv, key: cv, flags: byte) {
    requires no_overlap(nd, left, right, key)
    requires m <= 32
    ensures nd = f5(key, flags, left, right)
    trace depends on m
    stack 64
}
