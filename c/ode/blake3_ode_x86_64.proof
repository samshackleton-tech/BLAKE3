=== ode-helpers ===
order: h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 ode_7jb2pyzuwz6tqd3qmjsra3mk36tl4547sfpy3at5scbk772lbila
layout node120 120 { r0: cv at 0, r1: 64 bytes at 32, r2: number at 96, r3: number at 104 below 65, r4: byte at 112 }

layout keyed 40 { key: cv at 0, r4: byte at 32 }

contract h0(h: cv, m: block, length: word, t: counter, flags: low word) {
    requires no_overlap(h, m)
    ensures h = f2(h, m, t, length, flags)
    stack 0
    needs sse41
}

contract h1(h: cv, m: block, length: low byte, t: counter, flags: low byte) {
    requires no_overlap(h, m)
    ensures h = f2(h, m, t, length, flags)
    stack 0
    needs avx512
}

contract h2(inputs: 32 inputs, n: number, key: cv, t: counter, packed: bytes flags start end length, out: 32 cvs) {
    requires n >= 1
    requires no_overlap(inputs, key, out)
    ensures out[i] = M0(key, t + i, flags, start, end, length, n, inputs[i]) for i in 0..32
    trace depends on n
    stack 4096
    needs avx512
}

contract h3(inputs: 16 inputs, n: number, key: cv, t: counter, packed: bytes flags start end length, out: 16 cvs) {
    requires n >= 1
    requires no_overlap(inputs, key, out)
    ensures out[i] = M0(key, t, flags, start, end, length, n, inputs[i]) for i in 0..16
    trace depends on n
    stack 4096
    needs avx512
}

contract h4(inputs: 32 inputs, n: number, key: cv, t: counter, packed: bytes flags start end length, out: 32 cvs) {
    requires n >= 1
    requires no_overlap(inputs, key, out)
    ensures out[i] = M0(key, t, flags, start, end, length, n, inputs[i]) for i in 0..32
    trace depends on n
    stack 4096
    needs avx512
}

contract h5(block: 64 bytes, src: n bytes, n: number) {
    requires no_overlap(block, src)
    requires n <= 64
    ensures block = f7(src)
    trace depends on n
    stack 48
}

contract h6(out: cv, nd: node120, root: byte, plat: any) {
    requires no_overlap(out, nd)
    ensures out = f1(nd, root)
    trace depends on plat
    stack 128
    needs sse41
    needs avx512 if plat == 5
}

contract h7(nd: node120, input: len bytes, len: number, t: number, flags: byte, plat: any) {
    requires no_overlap(nd, input)
    requires len <= 1024
    ensures nd = f5(nd.r0, t, flags, input)
    trace depends on len, plat
    stack 256
    needs sse41
    needs avx512 if plat == 5
}

contract h8(out: cv, input: 32768 bytes, kf: keyed, t: number) {
    requires no_overlap(out, input, kf)
    requires 1024 * t + 32768 <= 18446744073709551615
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on t
    stack 8192
    needs avx512
}

contract h9(out: cv, input: 131072 bytes, kf: keyed, t: number) {
    requires no_overlap(out, input, kf)
    requires 1024 * t + 131072 <= 18446744073709551615
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on t
    stack 16384
    needs avx512
}

contract h10(out: cv, input: len bytes, len: number, kf: keyed, t: number, cvs: cvs) {
    requires no_overlap(out, input, kf, cvs)
    requires len >= 1
    requires 1024 * t + len <= 18446744073709551615
    requires cvs[i] == f1(f5(kf.key, t + i, kf.r4, input[1024 * i .. 1024 * i + 1024]), 0) for i in 0..len / 1024
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on len, t
    decreases len
    stack 640 + 384 * bits((len - 1) / 1024)
    needs sse41
    needs avx512
}

contract h11(out: cv, input: len bytes, len: number, kf: keyed, t: number) {
    requires no_overlap(out, input, kf)
    requires len >= 1025
    requires len <= 32768
    requires 1024 * t + len <= 18446744073709551615
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on len, t
    stack 8192
    needs sse41
    needs avx512
}

contract h12(out: cv, input: len bytes, len: number, kf: keyed, t: number, plat: any) {
    requires no_overlap(out, input, kf)
    requires len >= 1
    requires 1024 * t + len <= 18446744073709551615
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on len, t, plat
    decreases len
    stack 16896 + 384 * bits((len - 1) / 1024)
    needs sse41
    needs avx512 if plat == 5
}

contract h14(block: 64 bytes, src: n bytes, n: number) {
    calling {
        in block = r10, src = rsi, n = rdx
        preserves rdi, rsi, rdx, rbx, rbp, r12, r13, r14, r15
    }
    requires no_overlap(block, src)
    requires n <= 64
    ensures block = f7(src)
    trace depends on n
    stack 0
}

contract h15(nd: node120, input: len bytes, len: number, t: number, flags: byte, plat: any) {
    requires no_overlap(nd, input)
    requires len <= 1024
    ensures nd = f5(nd.r0, t, flags, input)
    trace depends on len, plat
    stack 256
    needs sse41
    needs avx512 if plat == 5
}

contract h13(out: 32 bytes, input: len bytes, len: number, key: 32 bytes, flags: byte, plat: any) {
    requires no_overlap(out, input, key)
    ensures out = bytes_of(f0(words(key), flags, input))
    trace depends on len, flags, plat
    stack 18672 + 384 * bits(len / 1024)
    needs sse41
    needs avx512 if plat == 5
}
