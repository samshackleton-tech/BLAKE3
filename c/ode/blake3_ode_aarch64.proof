layout m1__keyed 40 { key: cv at 0, r4: byte at 32 }

contract h0(h: cv, m: block, length: word, t: counter, flags: low word) {
    requires no_overlap(h, m)
    ensures h = f2(h, m, t, length, flags)
    stack 0
}

contract h4(out: block, input: 4096 bytes, kf: m1__keyed, t: number) {
    requires no_overlap(out, input, kf)
    requires 1024 * t + 4096 <= 18446744073709551615
    ensures out = f8(kf.key, kf.r4, t, input)
    stack 544
}

contract h1(block: 64 bytes, src: n bytes, n: number) {
    requires no_overlap(block, src)
    requires n <= 64
    ensures block = f7(src)
    trace depends on n
    stack 0
    calling {
            in block = x0, src = x1, n = x2
            preserves x15, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29
        }
}

contract h3(out: cv, nd: m1__node120, root: byte) {
    requires no_overlap(out, nd)
    ensures out = f1(nd, root)
    stack 0
}

contract h2(nd: m1__node120, input: len bytes, len: number, t: number, flags: byte) {
    requires no_overlap(nd, input)
    requires len <= 1024
    ensures nd = f5(nd.r0, t, flags, input)
    trace depends on len
    stack 64
}

contract h5(out: cv, input: len bytes, len: number, kf: m1__keyed, t: number) {
    requires no_overlap(out, input, kf)
    requires len >= 1
    requires 1024 * t + len <= 18446744073709551615
    ensures out = f10(kf.key, kf.r4, t, input)
    trace depends on len
    decreases len
    stack 816 + 272 * bits((len - 1) / 1024)
}

contract h6(out: 32 bytes, input: len bytes, len: number, key: 32 bytes, flags: byte) {
    requires no_overlap(out, input, key)
    requires len >= 1025
    ensures out = bytes_of(f0(words(key), flags, input))
    trace depends on len
    stack 1120 + 272 * bits(len / 1024)
}
