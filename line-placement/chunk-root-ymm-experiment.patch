From 5c8fdb5057f9aa99cf32091124b7567e8be7d2af Mon Sep 17 00:00:00 2001
From: Sam Shackleton <samshackleton-tech@users.noreply.github.com>
Date: Sat, 24 Oct 2026 08:08:14 +0000
Subject: [PATCH] x86 chunk root (experiment): AVX-512 entry loads each block
 in two 32-byte loads

With the caller's buffer 16 or 48 bytes into a cache line, the 16-byte
movups loads sit inside one of a 64-byte memcpy's two 32-byte stores that
the line splits; diagnostic maps put hash() of 64 bytes at 1.30/1.38 ns/B
there against 0.94 at 0/32 (stli_other 1.55-2.39 per 1k instructions
against 0.27). Experiment: load as the stores were made.
---
 c/blake3_chunk_root_x86-64_unix.S | 21 +++++++++++++--------
 tools/gen_x86_chunk_root.py       | 19 +++++++++++++++----
 2 files changed, 28 insertions(+), 12 deletions(-)

diff --git a/c/blake3_chunk_root_x86-64_unix.S b/c/blake3_chunk_root_x86-64_unix.S
index ffff0b8..621ebeb 100644
--- a/c/blake3_chunk_root_x86-64_unix.S
+++ b/c/blake3_chunk_root_x86-64_unix.S
@@ -270,14 +270,16 @@ _CET_ENDBR
         vmovq xmm9, rax
         vpxor xmm3, xmm3, xmm3
         vpunpcklqdq xmm3, xmm3, xmm9
-        vmovups xmm4, xmmword ptr [rdi]
-        vmovups xmm5, xmmword ptr [rdi+0x10]
+        vmovdqu ymm10, ymmword ptr [rdi]
+        vmovdqu ymm11, ymmword ptr [rdi+0x20]
+        vmovdqa xmm4, xmm10
+        vextracti128 xmm5, ymm10, 1
+        vmovdqa xmm6, xmm11
+        vextracti128 xmm7, ymm11, 1
         vmovaps xmm8, xmm4
         vshufps xmm4, xmm4, xmm5, 136
         vshufps xmm8, xmm8, xmm5, 221
         vmovaps xmm5, xmm8
-        vmovups xmm6, xmmword ptr [rdi+0x20]
-        vmovups xmm7, xmmword ptr [rdi+0x30]
         vmovaps xmm8, xmm6
         vshufps xmm6, xmm6, xmm7, 136
         vpshufd xmm6, xmm6, 0x93
@@ -358,14 +360,16 @@ _CET_ENDBR
         vmovq xmm9, rax
         vpxor xmm3, xmm3, xmm3
         vpunpcklqdq xmm3, xmm3, xmm9
-        vmovups xmm4, xmmword ptr [rdx]
-        vmovups xmm5, xmmword ptr [rdx+0x10]
+        vmovdqu ymm10, ymmword ptr [rdx]
+        vmovdqu ymm11, ymmword ptr [rdx+0x20]
+        vmovdqa xmm4, xmm10
+        vextracti128 xmm5, ymm10, 1
+        vmovdqa xmm6, xmm11
+        vextracti128 xmm7, ymm11, 1
         vmovaps xmm8, xmm4
         vshufps xmm4, xmm4, xmm5, 136
         vshufps xmm8, xmm8, xmm5, 221
         vmovaps xmm5, xmm8
-        vmovups xmm6, xmmword ptr [rdx+0x20]
-        vmovups xmm7, xmmword ptr [rdx+0x30]
         vmovaps xmm8, xmm6
         vshufps xmm6, xmm6, xmm7, 136
         vpshufd xmm6, xmm6, 0x93
@@ -431,4 +435,5 @@ _CET_ENDBR
         vpxor xmm1, xmm1, xmm3
         vmovups xmmword ptr [r8], xmm0
         vmovups xmmword ptr [r8+0x10], xmm1
+        vzeroupper
         ret
diff --git a/tools/gen_x86_chunk_root.py b/tools/gen_x86_chunk_root.py
index 8c524ec..1a61e52 100644
--- a/tools/gen_x86_chunk_root.py
+++ b/tools/gen_x86_chunk_root.py
@@ -27,8 +27,9 @@ The chunk counter is 0. CHUNK_START goes on the first block, CHUNK_END and
 ROOT on the last. Only the arguments' memory is read or written: no push, no
 spill, no stack scratch, no constant loads (IV and shuffle masks are built
 from immediates). Clobbers rax, rcx, rdx, rdi, r9-r11, xmm0-xmm15 and flags,
-all caller-saved. The sse41 entry needs SSE4.1; the avx512 entry needs
-AVX-512F and AVX-512VL (vprord on xmm).
+all caller-saved (the avx512 entry also ymm10/ymm11, and ends with
+vzeroupper). The sse41 entry needs SSE4.1; the avx512 entry needs
+AVX-512F and AVX-512VL (vprord on xmm) and AVX2 (vextracti128).
 
 The compression body is upstream BLAKE3's blake3_compress_in_place_sse41,
 instruction for instruction, with its rotations rendered per ISA. Proof
@@ -94,7 +95,16 @@ def render(isa, ins):
 def body(isa, block_ptr):
     """Compress xmm0..xmm3 with the block at block_ptr; CV out in xmm0/xmm1."""
     out = []
-    for ins in stream(LOAD.format(p=block_ptr)):
+    load = stream(LOAD.format(p=block_ptr))
+    if isa == 'avx512':
+        # The block in two 32-byte loads, the shape of a 33-64 byte memcpy's
+        # stores: a load inside one store whose line split it is otherwise
+        # held until that store commits (bench-hashes #65 follow-up).
+        out += [f'vmovdqu ymm10, ymmword ptr [{block_ptr}]', f'vmovdqu ymm11, ymmword ptr [{block_ptr}+0x20]',
+                'vmovdqa xmm4, xmm10', 'vextracti128 xmm5, ymm10, 1',
+                'vmovdqa xmm6, xmm11', 'vextracti128 xmm7, ymm11, 1']
+        load = [ins for ins in load if not (ins[0] == 'movups' and '[' in ins[2])]
+    for ins in load:
         out += render(isa, ins)
     out.append('mov al, 7')
     out.append('9:')
@@ -143,7 +153,8 @@ def kernel(isa):
     out += qword_pair(isa, 'xmm2', IV)
     out += ['mov eax, r11d', 'or eax, ecx', f'or eax, {CHUNK_END | ROOT}', 'shl rax, 32', 'or rax, r10'] + row3(isa)
     out += body(isa, 'rdx')
-    out += [f'{x}movups xmmword ptr [r8], xmm0', f'{x}movups xmmword ptr [r8+0x10], xmm1', 'ret']
+    out += [f'{x}movups xmmword ptr [r8], xmm0', f'{x}movups xmmword ptr [r8+0x10], xmm1']
+    out += ['vzeroupper', 'ret'] if isa == 'avx512' else ['ret']
     return out
 
 
