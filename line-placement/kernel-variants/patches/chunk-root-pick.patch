From 6f9d9620d0886b1a99a031cb4031aa2f61cf6016 Mon Sep 17 00:00:00 2001
From: Sam Shackleton <samshackleton-tech@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:33:12 +0000
Subject: [PATCH] x86 chunk root (experiment): one 64-byte load for blocks
 16/48 into a line

The AVX-512 entry picks its block load by the block's place in its cache
line: 16 or 48 bytes in, one vmovdqu32 (quarters split in registers); at 0
or 32, upstream's four 16-byte loads. EPYC 9255 maps: 64 B at 0/32 0.94
ns/B flat with 16-byte loads; at 16/48 1.30-1.38 with them, 0.96 with one
64-byte load (which brings #65's windows back there). New test: every
length at line offsets around 0/16/32/48.
---
 c/blake3_chunk_root_x86-64_unix.S | 29 +++++++++++++++++++++++++----
 src/ffi_chunk_root.rs             | 24 ++++++++++++++++++++++++
 tools/gen_x86_chunk_root.py       | 26 ++++++++++++++++++++++----
 3 files changed, 71 insertions(+), 8 deletions(-)

diff --git a/c/blake3_chunk_root_x86-64_unix.S b/c/blake3_chunk_root_x86-64_unix.S
index ffff0b8..ac37e33 100644
--- a/c/blake3_chunk_root_x86-64_unix.S
+++ b/c/blake3_chunk_root_x86-64_unix.S
@@ -270,14 +270,24 @@ _CET_ENDBR
         vmovq xmm9, rax
         vpxor xmm3, xmm3, xmm3
         vpunpcklqdq xmm3, xmm3, xmm9
+        test rdi, 16
+        jz 5f
+        vmovdqu32 zmm10, zmmword ptr [rdi]
+        vmovdqa xmm4, xmm10
+        vextracti32x4 xmm5, zmm10, 1
+        vextracti32x4 xmm6, zmm10, 2
+        vextracti32x4 xmm7, zmm10, 3
+        jmp 4f
+5:
         vmovups xmm4, xmmword ptr [rdi]
         vmovups xmm5, xmmword ptr [rdi+0x10]
+        vmovups xmm6, xmmword ptr [rdi+0x20]
+        vmovups xmm7, xmmword ptr [rdi+0x30]
+4:
         vmovaps xmm8, xmm4
         vshufps xmm4, xmm4, xmm5, 136
         vshufps xmm8, xmm8, xmm5, 221
         vmovaps xmm5, xmm8
-        vmovups xmm6, xmmword ptr [rdi+0x20]
-        vmovups xmm7, xmmword ptr [rdi+0x30]
         vmovaps xmm8, xmm6
         vshufps xmm6, xmm6, xmm7, 136
         vpshufd xmm6, xmm6, 0x93
@@ -358,14 +368,24 @@ _CET_ENDBR
         vmovq xmm9, rax
         vpxor xmm3, xmm3, xmm3
         vpunpcklqdq xmm3, xmm3, xmm9
+        test rdx, 16
+        jz 5f
+        vmovdqu32 zmm10, zmmword ptr [rdx]
+        vmovdqa xmm4, xmm10
+        vextracti32x4 xmm5, zmm10, 1
+        vextracti32x4 xmm6, zmm10, 2
+        vextracti32x4 xmm7, zmm10, 3
+        jmp 4f
+5:
         vmovups xmm4, xmmword ptr [rdx]
         vmovups xmm5, xmmword ptr [rdx+0x10]
+        vmovups xmm6, xmmword ptr [rdx+0x20]
+        vmovups xmm7, xmmword ptr [rdx+0x30]
+4:
         vmovaps xmm8, xmm4
         vshufps xmm4, xmm4, xmm5, 136
         vshufps xmm8, xmm8, xmm5, 221
         vmovaps xmm5, xmm8
-        vmovups xmm6, xmmword ptr [rdx+0x20]
-        vmovups xmm7, xmmword ptr [rdx+0x30]
         vmovaps xmm8, xmm6
         vshufps xmm6, xmm6, xmm7, 136
         vpshufd xmm6, xmm6, 0x93
@@ -431,4 +451,5 @@ _CET_ENDBR
         vpxor xmm1, xmm1, xmm3
         vmovups xmmword ptr [r8], xmm0
         vmovups xmmword ptr [r8+0x10], xmm1
+        vzeroupper
         ret
diff --git a/src/ffi_chunk_root.rs b/src/ffi_chunk_root.rs
index 10ca227..bf23d25 100644
--- a/src/ffi_chunk_root.rs
+++ b/src/ffi_chunk_root.rs
@@ -97,6 +97,30 @@ mod test {
         }
     }
 
+    /// Every placement of the input within a cache line that selects a
+    /// different load path in the avx512 kernel (16 and 48 bytes in: one
+    /// 64-byte load), and the bytes around them, for every length.
+    #[test]
+    fn test_chunk_root_line_placements() {
+        #[repr(C, align(64))]
+        struct Lines([u8; 2 * CHUNK_LEN]);
+        let variants = variants();
+        let mut lines = Lines([0; 2 * CHUNK_LEN]);
+        crate::test::paint_test_input(&mut lines.0);
+        let keyed = crate::platform::words_from_le_bytes_32(&[0x42; 32]);
+        for &avx512 in &variants {
+            for offset in [0, 1, 15, 16, 17, 31, 32, 33, 47, 48, 49, 63, 64 + 16, 64 + 48] {
+                for len in 0..=CHUNK_LEN {
+                    for (key, flags) in [(crate::IV, 0), (&keyed, crate::KEYED_HASH)] {
+                        let input = &lines.0[offset..][..len];
+                        let got = unsafe { chunk_root(avx512, input, key, flags) };
+                        assert_eq!(got, reference(input, key, flags), "avx512={avx512} offset={offset} len={len} flags={flags}");
+                    }
+                }
+            }
+        }
+    }
+
     /// The kernel source keeps off the stack and out of constant memory:
     /// no push or pop, no rsp- or rbp-based operand, no rip-relative load.
     /// A kernel that spilled would put the aliasing it exists to avoid
diff --git a/tools/gen_x86_chunk_root.py b/tools/gen_x86_chunk_root.py
index 8c524ec..f5f8385 100644
--- a/tools/gen_x86_chunk_root.py
+++ b/tools/gen_x86_chunk_root.py
@@ -27,8 +27,9 @@ The chunk counter is 0. CHUNK_START goes on the first block, CHUNK_END and
 ROOT on the last. Only the arguments' memory is read or written: no push, no
 spill, no stack scratch, no constant loads (IV and shuffle masks are built
 from immediates). Clobbers rax, rcx, rdx, rdi, r9-r11, xmm0-xmm15 and flags,
-all caller-saved. The sse41 entry needs SSE4.1; the avx512 entry needs
-AVX-512F and AVX-512VL (vprord on xmm).
+all caller-saved (the avx512 entry also zmm10, and ends with vzeroupper).
+The sse41 entry needs SSE4.1; the avx512 entry needs AVX-512F and AVX-512VL
+(vprord on xmm).
 
 The compression body is upstream BLAKE3's blake3_compress_in_place_sse41,
 instruction for instruction, with its rotations rendered per ISA. Proof
@@ -94,7 +95,23 @@ def render(isa, ins):
 def body(isa, block_ptr):
     """Compress xmm0..xmm3 with the block at block_ptr; CV out in xmm0/xmm1."""
     out = []
-    for ins in stream(LOAD.format(p=block_ptr)):
+    load = stream(LOAD.format(p=block_ptr))
+    if isa == 'avx512':
+        # Experiment (#141): a block 16 or 48 bytes into its cache line in
+        # one 64-byte load, its quarters split in registers (EPYC 9255: 0.96
+        # ns/B where four 16-byte loads take 1.30-1.38); otherwise upstream's
+        # four 16-byte loads (0.94, and no line-crossing load).
+        out += [f'test {block_ptr}, 16', 'jz 5f',
+                f'vmovdqu32 zmm10, zmmword ptr [{block_ptr}]',
+                'vmovdqa xmm4, xmm10', 'vextracti32x4 xmm5, zmm10, 1',
+                'vextracti32x4 xmm6, zmm10, 2', 'vextracti32x4 xmm7, zmm10, 3', 'jmp 4f',
+                '5:']
+        for ins in load:
+            if ins[0] == 'movups' and '[' in ins[2]:
+                out += render(isa, ins)
+        out.append('4:')
+        load = [ins for ins in load if not (ins[0] == 'movups' and '[' in ins[2])]
+    for ins in load:
         out += render(isa, ins)
     out.append('mov al, 7')
     out.append('9:')
@@ -143,7 +160,8 @@ def kernel(isa):
     out += qword_pair(isa, 'xmm2', IV)
     out += ['mov eax, r11d', 'or eax, ecx', f'or eax, {CHUNK_END | ROOT}', 'shl rax, 32', 'or rax, r10'] + row3(isa)
     out += body(isa, 'rdx')
-    out += [f'{x}movups xmmword ptr [r8], xmm0', f'{x}movups xmmword ptr [r8+0x10], xmm1', 'ret']
+    out += [f'{x}movups xmmword ptr [r8], xmm0', f'{x}movups xmmword ptr [r8+0x10], xmm1']
+    out += ['vzeroupper', 'ret'] if isa == 'avx512' else ['ret']
     return out
 
 
